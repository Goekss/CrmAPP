@model CrmAPP.ViewModels.ChangePasswordViewModel

@{
    ViewBag.Title = "Passwort ändern";
}

<style>
    .toggle-password {
        position: absolute;
        top: 12px;
        right: 10px;
        cursor: pointer;
        font-size: 18px;
        color: #555;
    }
</style>

<h2>@ViewBag.Title</h2>
<hr />

<!-- ✔️ BAŞARI MESAJI -->

@if (TempData["PasswortAenderungErfolg"] != null)
{
    <div class="alert alert-success" id="success-message">

        <h4>@TempData["PasswortAenderungErfolg"]</h4>
        
        <strong style="color:black">Aus Sicherheitsgründen müssen Sie sich erneut anmelden.</strong>
        <br>
        Sie werden zum Login-Panel umgeleitet...

        <span id="countdown" style="font-weight:bold;color:black">10</span> <small>sec..</small>

    </div>
    <script>
        var seconds = 2;
        var countdownElem = document.getElementById('countdown');
        var timer = setInterval(function() {
            seconds--;
            countdownElem.textContent = seconds;
            if (seconds <= 0) {
                clearInterval(timer);
                window.location.href = '@Url.Action("Login", "Security")';
            }
        }, 1000);
    </script>
}
@using (Html.BeginForm("ChangePassword", "MeinProfil", FormMethod.Post))
{
    @Html.AntiForgeryToken()

    <div class="mt-5">
        <!-- 🔐 Aktuelles Passwort -->
        <div class="form-group mt-3 mb-4">
            @Html.LabelFor(m => m.CurrentPassword, htmlAttributes: new { @class = "control-label col-md-5" })
            <div class="col-md-4">
                <div class="input-group">
                    <span class="input-group-text" style="background-color: #f1f1f1">
                        <i class="bx bxs-lock-alt"></i>
                    </span>
                    @Html.PasswordFor(m => m.CurrentPassword, new { @class = "form-control password-input", id = "currentPassword" })
                    <span class="input-group-text cursor-pointer" style="background-color: #f1f1f1">
                        <i class="bx bx-hide toggle-password" data-target="currentPassword"></i>
                    </span>
                </div>

                @* Bireysel alan hatası *@
                @Html.ValidationMessageFor(m => m.CurrentPassword, "", new { @class = "text-danger" })

                @* ❌ Genel hata mesajları (küçük kırmızı yazı olarak alta eklendi) *@
                <div class="text-danger" style="font-size: 13px; margin-top: 4px;">
                    @Html.ValidationSummary(true, "", new { @class = "" })
                </div>
            </div>
        </div>

        <!-- 🆕 Neues Passwort -->
        <div class="form-group mb-4">
            @Html.LabelFor(m => m.NewPassword, htmlAttributes: new { @class = "control-label col-md-5" })
            <div class="col-md-4">
                <div class="input-group">
                    <span class="input-group-text" style="background-color: #f1f1f1">
                        <i class="bx bxs-key"></i>
                    </span>
                    @Html.PasswordFor(m => m.NewPassword, new { @class = "form-control password-input", id = "newPassword" })
                    <span class="input-group-text cursor-pointer" style="background-color: #f1f1f1">
                        <i class="bx bx-hide toggle-password" data-target="newPassword"></i>
                    </span>
                </div>
                @Html.ValidationMessageFor(m => m.NewPassword, "", new { @class = "text-danger" })

                <!-- Şifre gücü çubuğu -->
                <div class="d-flex align-items-center mt-2">
                    <div class="progress" style="height: 3px; width: 25%; background-color:#bebebe">
                        <div id="passwordStrength" class="progress-bar" role="progressbar" style="width: 0%;"></div>
                    </div>
                    <span class="ms-2" id="passwordStrengthText" style="font-size: 10px; color: #444;"></span>
                </div>
            </div>
        </div>

        <!-- ✅ Passwort bestätigen -->
        <div class="form-group mb-4">
            @Html.LabelFor(m => m.ConfirmPassword, htmlAttributes: new { @class = "control-label col-md-5" })
            <div class="col-md-4">
                <div class="input-group">
                    <span class="input-group-text" style="background-color: #f1f1f1">
                        <i class="bx bxs-check-shield"></i>
                    </span>
                    @Html.PasswordFor(m => m.ConfirmPassword, new { @class = "form-control password-input", id = "confirmPassword" })
                    <span class="input-group-text cursor-pointer" style="background-color: #f1f1f1">
                        <i class="bx bx-hide toggle-password" data-target="confirmPassword"></i>
                    </span>
                </div>
                @Html.ValidationMessageFor(m => m.ConfirmPassword, "", new { @class = "text-danger" })
            </div>
        </div>

    </div>

    
   

    <button type="submit" class="btn btn-success ">Speichern</button>
    
}

<hr />
<a href="@Url.Action("Index", "MeinProfil")" class="btn btn-secondary">Zurück</a>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        // 👁️ toggle-password işlevi
        document.querySelectorAll(".toggle-password").forEach(function (toggle) {
            toggle.addEventListener("click", function () {
                const targetId = this.getAttribute("data-target");
                const input = document.getElementById(targetId);
                if (input.type === "password") {
                    input.type = "text";
                    this.classList.replace("bx-hide", "bx-show");
                } else {
                    input.type = "password";
                    this.classList.replace("bx-show", "bx-hide");
                }
            });
        });

        // 🔒 Şifre gücü hesaplama
        const passwordInput = document.getElementById("newPassword");
        const strengthBar = document.getElementById("passwordStrength");
        const strengthText = document.getElementById("passwordStrengthText");

        passwordInput.addEventListener("input", function () {
            const val = passwordInput.value;
            let strength = 0;
            if (val.length >= 6) strength++;
            if (/[A-Z]/.test(val)) strength++;
            if (/[0-9]/.test(val)) strength++;
            if (/[^A-Za-z0-9]/.test(val)) strength++;

            strengthBar.style.width = (strength * 25) + "%";
            const levels = ["Sehr schwach", "Schwach", "Mittel", "Stark", "Sehr stark"];
            strengthText.textContent = levels[strength] || "";
        });
    });
</script>