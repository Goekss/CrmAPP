
@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<script src="~/Scripts/apexcharts.js"></script>
<script src="~/Scripts/chart.js"></script>
<script src="~/Scripts/highdiagram.js"></script>
<script src="~/Scripts/hcharts-3d.js"></script>




<style>
    .b1, .b2, .b3 {
        cursor: pointer; /* Imleç işareti - Cursor-Symbol */
        margin-top: 10px; /* Üst boşluk - Obere Rand */
        background-color: whitesmoke; /* Beyazımsı arka plan rengi - Rauchweiß Hintergrundfarbe */
        padding: 10px; /* İç boşluk - Innenabstand */
        border-radius: 10px; /* Kenar yuvarlatma - Randradius */
        text-align: center; /* Metin hizalama - Textausrichtung */
        box-shadow: 0px 2px 5px rgba(0, 0, 0, 0.4); /* Kutu gölgesi - Box-Schatten */
        transition: transform 0.9s; /* Geçiş süresi - Übergangsdauer */
        text-decoration: none; /* Metin dekorasyonu - Textdekoration */
        height: 50px; /* Yükseklik - Höhe */
        display: flex; /* Esnek kutu modeli - Flexbox-Modell */
        align-items: center; /* Öğeleri ortalama - Elemente zentrieren */
    }

        .b1:hover, .b2:hover, .b3:hover {
            background-color: white; /* Hover arka plan rengi - Hintergrundfarbe bei Hover */
        }

    .icon {
        margin-bottom: 25px; /* Alt boşluk - Unterer Rand */
        margin-top: 30px; /* Üst boşluk - Obere Rand */
        float: right; /* Sağ tarafa hizalama - Rechts ausrichten */
        color: gray; /* Renk - Farbe */
        font-size: 1px; /* Yazı boyutu - Schriftgröße */
        transition: color 1s, font-size 1s; /* Renk ve yazı boyutu geçişi - Übergang von Farbe und Schriftgröße */
    }

        .icon:hover {
            color: cadetblue; /* Hover renk - Farbe bei Hover */
            font-size: 15px; /* Hover yazı boyutu - Schriftgröße bei Hover */
        }

    .iconCont {
        float: right; /* Sağ tarafa hizalama - Rechts ausrichten */
        display: flex; /* Esnek kutu modeli - Flexbox-Modell */
        margin-right: 30px; /* Sağ boşluk - Rechter Rand */
        gap: 10px; /* Boşluk - Abstand */
        padding-bottom: 20px; /* Alt boşluk - Unterer Rand */
    }

    .uhrkalender {
        text-align: start; /* Metin hizalama - Textausrichtung */
        margin-top: 50px; /* Üst boşluk - Oberer Rand */
        margin-left: 30px; /* Sol boşluk - Linker Rand */
        width: 96%; /* Genişlik - Breite */
    }

    #kalender {
        background-color: red; /* Arka plan rengi - Hintergrundfarbe */
        margin-left: 550px; /* Sol boşluk - Linker Rand */
        height: 50px; /* Yükseklik - Höhe */
        justify-content: right; /* Sağa hizalama - Rechts ausrichten */
    }

    #fullDiv {
        margin: 0; /* Boşluk yok - Kein Rand */
        left: 0; /* Sol hizalama - Links ausrichten */
        top: 0; /* Üst hizalama - Oben ausrichten */
        bottom: 0; /* Alt hizalama - Unten ausrichten */
        overflow: hidden; /* Taşmayı gizle - Überlauf verbergen */
    }

        #fullDiv ul {
            margin: 0px; /* Boşluk yok - Kein Rand */
            padding: 0px; /* Dolgu yok - Kein Polster */
        }

        #fullDiv li {
            float: left; /* Sol hizalama - Links ausrichten */
            display: block; /* Blok eleman - Blockelement */
            width: 14.2857%; /* Genişlik - Breite */
            text-align: center; /* Metin hizalama - Textausrichtung */
            list-style-type: none; /* Liste stili yok - Keine Listenart */
        }

            #fullDiv li:nth-child(n+1):nth-child(-n+7) {
                font-weight: 900; /* Yazı kalınlığı - Schriftstärke */
                color: #e67e22; /* Renk - Farbe */
            }

            #fullDiv li:nth-child(n+39), #fullDiv li:nth-child(n+8):nth-child(-n+16) {
                font-weight: 900; /* Yazı kalınlığı - Schriftstärke */
                color: rgba(0,0,0,.3); /* Renk - Farbe */
            }

            #fullDiv li:hover:nth-child(n+8):nth-child(-n+38), #fullDiv li:nth-child(17) {
                border-radius: 5px; /* Kenar yuvarlatma - Randradius */
                background-color: #1abc9c; /* Arka plan rengi - Hintergrundfarbe */
                color: #ecf0f1; /* Renk - Farbe */
            }

    .calendar {
        display: flex; /* Esnek kutu modeli - Flexbox-Modell */
        flex-direction: column; /* Kolon yönlendirme - Spaltenausrichtung */
        width: 100%; /* Genişlik - Breite */
        height: 100%; /* Yükseklik - Höhe */
        color: black; /* Renk - Farbe */
        font-size: 10px; /* Yazı boyutu - Schriftgröße */
    }

    .calendar-header {
        padding: 5px; /* Dolgu - Polster */
        text-align: center; /* Metin hizalama - Textausrichtung */
        background-color: #d5d5d5; /* Arka plan rengi - Hintergrundfarbe */
        border-radius: 10px 10px 0 0; /* Kenar yuvarlatma - Randradius */
    }

    .calendar-controls {
        display: flex; /* Esnek kutu modeli - Flexbox-Modell */
        justify-content: center; /* Ortaya hizalama - Zentrieren */
        padding: 20px 0; /* Dolgu - Polster */
        gap: 10px; /* Boşluk - Abstand */
    }

    .calendar-weekdays {
        display: grid; /* Izgara modeli - Rastermodell */
        grid-template-columns: repeat(7, 1fr); /* 7 sütun - 7 Spalten */
        text-align: center; /* Metin hizalama - Textausrichtung */
        padding: 5px 0; /* Dolgu - Polster */
        margin-bottom: 5px; /* Alt boşluk - Unterer Rand */
        color: orange; /* Renk - Farbe */
    }

    .calendar-days {
        display: grid; /* Izgara modeli - Rastermodell */
        grid-template-columns: repeat(7, 1fr); /* 7 sütun - 7 Spalten */
        gap: 3px; /* Boşluk - Abstand */
        padding-top: 4px; /* Üst dolgu - Oberes Polster */
        overflow: hidden; /* Taşmayı gizle - Überlauf verbergen */
    }

        .calendar-days div {
            display: flex; /* Esnek kutu modeli - Flexbox-Modell */
            align-items: center; /* Öğeleri ortalama - Elemente zentrieren */
            justify-content: center; /* Ortaya hizalama - Zentrieren */
            margin-top: 2px; /* Üst boşluk - Oberer Rand */
            height: 15px; /* Yükseklik - Höhe */
            padding: 1px; /* Dolgu - Polster */
        }

    .prev-month-day, .next-month-day {
        color: lightgray; /* Renk - Farbe */
    }

    .current-day {
        font-weight: bold; /* Yazı kalınlığı - Schriftstärke */
        height: 30px; /* Yükseklik - Höhe */
        margin-left: 10px; /* Sol boşluk - Linker Rand */
        margin-bottom: 10px; /* Alt boşluk - Unterer Rand */
        background-color: orange; /* Arka plan rengi - Hintergrundfarbe */
        border-radius: 10px; /* Kenar yuvarlatma - Randradius */
        color: black; /* Renk - Farbe */
    }

    #month-year {
        color: rgba(95, 158, 160,2); /* Renk - Farbe */
    }

    #container1 {
        height: 400px; /* Yükseklik - Höhe */
        border-radius: 10px !important; /* Kenar yuvarlatma - Randradius */
    }

    .highcharts-figure, .highcharts-data-table table {
        min-width: 310px; /* Minimum genişlik - Mindestbreite */
        max-width: 882px !important; /* Maksimum genişlik - Maximalbreite */
        margin-left: 25px !important; /* Sol boşluk - Linker Rand */
        margin-top: -20px !important; /* Üst boşluk - Oberer Rand */
    }

    #sliders {
        margin: 0.3rem 10px; /* Boşluk - Abstand */
    }

        #sliders td input[type="range"] {
            display: inline; /* Çizgi içi model - Inline-Modell */
        }

        #sliders td {
            padding-right: 1em; /* Sağ dolgu - Rechtes Polster */
            white-space: nowrap; /* Boşlukları koru - Kein Zeilenumbruch */
        }

    .highcharts-description {
        margin: 0.3rem 10px; /* Boşluk - Abstand */
    }

    #alpha, #beta, #depth {
        width: 100%; /* Genişlik - Breite */
        height: 10px; /* Yükseklik - Höhe */
        background-color: lightgray !important; /* Arka plan rengi - Hintergrundfarbe */
        border-radius: 5px; /* Kenar yuvarlatma - Randradius */
        -webkit-appearance: none; /* Tarayıcı stili - Browser-Stil */
        appearance: none; /* Görünüm - Aussehen */
    }

    input[type="range"]::-webkit-slider-thumb {
        -webkit-appearance: none; /* Tarayıcı stili - Browser-Stil */
        appearance: none; /* Görünüm - Aussehen */
        width: 10px; /* Genişlik - Breite */
        height: 10px; /* Yükseklik - Höhe */
        border-radius: 50%; /* Kenar yuvarlatma - Randradius */
        background-color: cadetblue; /* Arka plan rengi - Hintergrundfarbe */
        border: none; /* Kenar yok - Kein Rand */
        cursor: pointer; /* İmleç işareti - Cursor-Symbol */
    }
</style>




