<!--Groß Kalender-->
<script>
    // Takvimde geçerli ay ve yılı tutan değişkenler // Variablen, die den aktuellen Monat und das Jahr im Kalender speichern
    let currentDate = new Date();
    let currentMonth = currentDate.getMonth();
    let currentYear = currentDate.getFullYear();

    // Takvimi render etme işlevi // Funktion zum Rendern des Kalenders
    function renderCalendar(year = currentYear, month = currentMonth) {
        const calendarDays = document.getElementById('calendar-days');
        const monthYear = document.getElementById('month-year');

        // Günlerin bilgilerini al // Informationen zu den Tagen holen
        const firstDayOfMonth = new Date(year, month, 1);
        const lastDayOfMonth = new Date(year, month + 1, 0);
        const daysInMonth = lastDayOfMonth.getDate();
        const firstWeekday = firstDayOfMonth.getDay(); // 0 (Pazar) - 6 (Cumartesi) // 0 (Sonntag) - 6 (Samstag)

        // Önceki ve sonraki ay bilgileri // Informationen über den vorherigen und nächsten Monat
        const prevMonthLastDay = new Date(year, month, 0).getDate();

        // Ay ve yıl başlığını ayarla // Monat und Jahr im Header setzen
        monthYear.textContent = new Date(year, month).toLocaleDateString("de-DE", {
            year: "numeric",
            month: "long"
        });

        // Takvim günlerini temizle // Kalendertage löschen
        calendarDays.innerHTML = "";

        // İlk günün hafta içi dizini (Pazar'ı haftanın sonu kabul ederek ayarlıyoruz) // Wochentagsindex des ersten Tages (unter der Annahme, dass Sonntag das Ende der Woche ist)
        const startDay = firstWeekday === 0 ? 6 : firstWeekday - 1;

        // Önceki ayın günlerini ekle // Tage des vorherigen Monats hinzufügen
        for (let i = startDay; i > 0; i--) {
            const day = document.createElement('div');
            day.classList.add('day', 'prev-month-day');
            day.textContent = prevMonthLastDay - i + 1;
            calendarDays.appendChild(day);
        }

        // Bu ayın günlerini ekle // Tage des aktuellen Monats hinzufügen
        const today = new Date();
        for (let day = 1; day <= daysInMonth; day++) {
            const dayCell = document.createElement('div');
            dayCell.classList.add('day');
            dayCell.textContent = day;

            // Eğer gün bugünkü gün ise, sınıfa 'current-day' ekle // Wenn der Tag der heutige Tag ist, Klasse 'current-day' hinzufügen
            if (day === today.getDate() && month === today.getMonth() && year === today.getFullYear()) {
                dayCell.classList.add('current-day');
            }

            calendarDays.appendChild(dayCell);
        }

        // Sonraki ayın günlerini ekle // Tage des nächsten Monats hinzufügen
        const remainingCells = 42 - (startDay + daysInMonth); // Toplam 42 hücre olması için // Um insgesamt 42 Zellen zu haben
        for (let i = 1; i <= remainingCells; i++) {
            const day = document.createElement('div');
            day.classList.add('day', 'next-month-day');
            day.textContent = i;
            calendarDays.appendChild(day);
        }
    }

    // Yıl ve ay seçeneklerini güncelleme // Aktualisierung der Jahres- und Monatsauswahl
    function updateSelectors() {
        const yearSelect = document.getElementById('year-select');
        const monthSelect = document.getElementById('month-select');

        // Yıl seçeneklerini doldur (2000'den 2200'e kadar) // Füllen Sie die Jahresauswahl (von 2000 bis 2200)
        for (let year = 2000; year <= 2200; year++) {
            const option = document.createElement('option');
            option.value = year;
            option.textContent = year;
            yearSelect.appendChild(option);
        }

        // Geçerli yılı ve ayı seçili olarak ayarla // Aktuelles Jahr und aktuellen Monat als ausgewählt setzen
        yearSelect.value = currentYear;
        monthSelect.value = currentMonth;

        // Yıl ve ay seçimleri değiştiğinde takvimi güncelle // Kalender aktualisieren, wenn Jahres- oder Monatsauswahl geändert wird
        yearSelect.addEventListener('change', function () {
            currentYear = parseInt(this.value);
            renderCalendar(currentYear, currentMonth);
        });

        monthSelect.addEventListener('change', function () {
            currentMonth = parseInt(this.value);
            renderCalendar(currentYear, currentMonth);
        });
    }

    // Ayı ileri veya geri almak için düğme işlevleri // Schaltflächenfunktionen zum Vor- oder Zurückstellen des Monats
    document.getElementById('prev-month-btn').addEventListener('click', function () {
        currentMonth--;
        if (currentMonth < 0) {
            currentMonth = 11;
            currentYear--;
        }
        document.getElementById('year-select').value = currentYear;
        document.getElementById('month-select').value = currentMonth;
        renderCalendar(currentYear, currentMonth);
    });

    document.getElementById('next-month-btn').addEventListener('click', function () {
        currentMonth++;
        if (currentMonth > 11) {
            currentMonth = 0;
            currentYear++;
        }
        document.getElementById('year-select').value = currentYear;
        document.getElementById('month-select').value = currentMonth;
        renderCalendar(currentYear, currentMonth);
    });

    // Sayfa yüklendiğinde takvimi oluştur ve yıl/ay seçeneklerini güncelle // Beim Laden der Seite Kalender erstellen und Jahres-/Monatsauswahl aktualisieren
    document.addEventListener('DOMContentLoaded', function () {
        updateSelectors();
        renderCalendar();
    });

</script>

