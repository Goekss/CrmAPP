<!--
    Die JAVASCRIPT-CODEN WURDEN VON GITHUB-COPILOT (80%) und VON MIR (20%) PROGRAMMIERT.

    Alle Code-Blöcke hier wurden nach dem Dashboart-Ansicht ausgerichtet und angepasst
-->
<!--Realzeit Uhr-->
<script>
    function updateClock() {
        const now = new Date(); // Şu anki tarih ve saat

        // Stunden, Minuten und Sekunden
        const hours = String(now.getHours()).padStart(2, '0');
        const minutes = String(now.getMinutes()).padStart(2, '0');
        const seconds = String(now.getSeconds()).padStart(2, '0');

        // Tage der Woche
        const days = ["Sonntag", "Montag", "Dienstag", "Mittwoch", "Donnerstag", "Freitag", "Samstag"];
        const day = days[now.getDay()]; // Tag der Woche

        // Tarih formatı- Datum Format
        const options = { day: 'numeric', month: 'long', year: 'numeric' };
        const date = now.toLocaleDateString('de-DE', options); // De- Format

        // Zeit- und Datumsformate
        const timeString = `${hours}:${minutes}:${seconds}`; // Uhr-format: HH:MM:SS
        const dateString = `${date}, ${day}`; // Datum und Tage

        // Zeit- und Datumsfelder aktualisieren
        document.getElementById('clock').textContent = timeString; // Uhr
        document.getElementById('date').textContent = dateString; // Datum
    }

    setInterval(updateClock, 1000); // Aktualisiere die Uhr jede Sekunde!
    updateClock(); // Beim ersten Laden der Seite die Zeit anzeigen


</script>



