                titleAttr: 'Drucken'
            },
            {
                extend: 'pdf',
                text: '<i class="icon-base bx bxs-file-pdf me-2 ms-1"></i> ',
                titleAttr: 'PDF'
            }

        ],
        responsive: true,
    });
</script>