<!--Dieser Skript-Code wurde von GitHub-Copilot bearbeitet!-->

<script>
    document.addEventListener('DOMContentLoaded', (event) => {              // Sayfa yüklendikten sonra çalışacak fonksiyonu başlatıyoruz && Wir starten die Funktion nach dem Laden der Seite
        const searchInput = document.getElementById('searchKundenInput');   // Arama input elementini alıyoruz && Wir holen das Such-Input-Element
        searchInput.addEventListener('keyup', function () {                 // Klavye tuşlarında arama işlemini tetikliyoruz & Wir lösen die Suchaktion aus, wenn eine Taste gedrückt wird
            const filter = searchInput.value.toLowerCase();                 // Arama terimini küçük harfe çeviriyoruz / Wir konvertieren den Suchbegriff in Kleinbuchstaben
            const table = document.getElementById('kundenTable');
            const trs = table.getElementsByTagName('tr');                   // Tablodaki tüm satırları alıyoruz / Wir holen alle Zeilen in der Tabelle

            for (let i = 1; i < trs.length; i++) {         // döngü yaparak, her satırı arama terimi ile karşılaştırıyoruz / Wir durchlaufen die Zeilen und vergleichen jede Zeile mit dem Suchbegriff
                const tds = trs[i].getElementsByTagName('td');              // Her satırdaki hücreleri alıyoruz / Wir holen die Zellen jeder Zeile
                let showRow = false;

                for (let j = 0; j < tds.length; j++) {                       // Her hücrede arama terimi ile karşılaştırma yapıyoruz / Wir vergleichen jede Zelle mit dem Suchbegriff
                    if (tds[j].textContent.toLowerCase().includes(filter)) {  // Eğer hücre içeriği arama terimi içeriyorsa satırı gösteriyoruz / Wenn der Zellinhalt den Suchbegriff enthält, zeigen wir die Zeile an
                        showRow = true;
                        break;
                    }
                }

                trs[i].style.display = showRow ? '' : 'none';               // Satırı gösterme veya gizleme / Zeile anzeigen oder ausblenden
            }
        });
    });
</script>
<script>
    // Sayfa yüklendikten sonra çalışacak fonksiyonu başlatıyoruz / Wir starten die Funktion nach dem Laden der Seite
    document.addEventListener('DOMContentLoaded', (event) => {              // DataTables kütüphanesini başlatıyoruz / Wir initialisieren die DataTables-Bibliothek

        const table = $('#kundenTable').DataTable({                         // İlk sütunda varsayılan sıralama / Standard-Sortierung in der ersten Spalte
            "order": [[0, "asc"]]
        });

        // DataTables araması ile entegre olabilmesi için özel arama inputu / Benutzerdefiniertes Suchfeld, das mit der DataTables-Suche integriert ist
        const searchInput = document.getElementById('searchKundenInput');
        searchInput.addEventListener('keyup', function () {                // Aramada her tuşa basıldığında DT'in arama fnk çağırıyoruz & Wir rufen die Suchfunktion von DaTab. bei jeder Taste auf
            table.search(this.value).draw();                               // Arama değeri ile tabloyu güncelliyoruz / Wir aktualisieren die Tabelle mit dem Suchwert
        });
    });
</script>
<script>
    $('#kundenTable').DataTable({
        language: {
            info: "_TOTAL_ Eintrag von _START_ bis _END_ werden angezeigt.",
            infoEmpty: "Keine Einträge vorhanden.",
            loadingRecords: "Einträge werden geladen.",
            zeroRecords: "Tabelle ist leer.",
            search: "Durchsuchen : ",
            infoFiltered: "(gefiltert aus insgesamt _MAX_ Einträgen)",
            buttons: {
                copyTitle: "In die Zwischenablage kopiert",
                copySuccess: "%d Zeilen wurden in die Zwischenablage kopiert",
                copy: "Kopieren ",
                print: "Drucken ",
                pdf: "PDF"
            },
            paginate: {
                first: "Erste",
                previous: "« Vorherige",
                next: "Nächste » ",
                last: "Letzte"
            }
        },

        dom: 'Bfrtip',
        buttons: [
            {
                extend: 'copy',
                text: '<i class="icon-base bx bx-copy me-1 ms-2 "></i> ',
                titleAttr: 'Kopieren'
            },
            {
