@{
    ViewBag.Title = "Kunden von Excel importieren";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div id="übrsch">
    <h3 class="text-lg-start mt-lg-5" style="color: cadetblue;">@ViewBag.Title</h3>
    <hr />
</div>

@* ----- MESAJ GÖSTERİM ALANI BAŞLANGIÇ ----- *@
@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success shadow">
        <strong>Erfolg!</strong> @TempData["SuccessMessage"]
    </div>
}
@if (TempData["ErrorList"] is List<string> errors && errors.Any())
{
    <div class="alert alert-warning shadow">
        <strong>Achtung!</strong> Die folgenden Zeilen wurden übersprungen:
        <ul class="mt-2 mb-0" style="max-height: 200px; overflow-y: auto;">
            @foreach (var error in errors)
            {
                <li>@error</li>
}
        </ul>
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger shadow">
        <strong>Fehler!</strong> @TempData["ErrorMessage"]
    </div>
}
@* ----- MESAJ GÖSTERİM ALANI BİTİŞ ----- *@

<div class="container-fluid ">
    <div class="row">
        <div class="col-lg-7 ">
            <div class="card shadow mt-lg-5">
                <div class="card-header " style="background-color: #4c7e80; color: white; ">
                    <i class="bx bxs-file-import "></i> Excel-Datei hochladen
                </div>
                <div class="card-body">
                    @using (Html.BeginForm("Import", "KundenDatens", FormMethod.Post, new { enctype = "multipart/form-data" }))
                    {
                        @Html.AntiForgeryToken()
                        <div class="form-group mb-lg-4 mt-lg-3">
                            <label for="excelFile" class="form-label"><b>Schritt 1:</b> Wählen Sie die Excel-Datei (.xlsx) aus.</label>
                            <input type="file" name="excelFile" id="excelFile" class="form-control mt-lg-4" accept=".xlsx" required />
                        </div>
                        <button type="submit" class="btn btn-primary " style="background-color: #4c7e80; border-color: #4c7e80;">
                            <i class="bx bxs-cloud-upload"></i> Hochladen und importieren
                        </button>
                        @Html.ActionLink("Zurück zur Liste", "Index", null, new { @class = "btn btn-secondary" })
                    }
                </div>
            </div>
        </div>
        <div class="col-lg-5 mt-lg-5">
            <div class="alert alert-warning shadow">
                <h4><i class="bx bx-info-circle"></i> Informationen zur Excel-Vorlage</h4>
                <p>Die Spalten in der Excel-Datei müssen in dieser Reihenfolge und mit den entsprechenden Überschriften sein:</p>
                <ol class="list-group list-group-flush">
                    <li class="list-group-item"><b>Spalte A:</b> Unternehmen (entspricht "Unternehmen")</li>
                    <li class="list-group-item"><b>Spalte B:</b> Vorname (entspricht "Vorname")</li>
                    <li class="list-group-item"><b>Spalte C:</b> Nachname (entspricht "Nachname")</li>
                    <li class="list-group-item"><b>Spalte D:</b> E-Mail (muss eindeutig sein, entspricht "Email")</li>
                    <li class="list-group-item"><b>Spalte E:</b> Telefon Mobil (entspricht "TelefonMobil")</li>
                    <li class="list-group-item"><b>Spalte F:</b> Telefon Haus (entspricht "TelefonHaus")</li>
                    <li class="list-group-item"><b>Spalte G:</b> Website (entspricht "Website")</li>
                    <li class="list-group-item"><b>Spalte H:</b> Adresse (entspricht "Adresse")</li>
                    <li class="list-group-item"><b>Spalte I:</b> Projekt/Auftrag (entspricht "ProjektAuftrag")</li>
                    <li class="list-group-item"><b>Spalte J:</b> Hinweise (entspricht "Hinweise")</li>
                </ol>
                <p class="mt-3"><b>Hinweis:</b> Bitte achten Sie darauf, dass die Spaltenüberschriften in der Excel-Datei mit der oben genannten Liste übereinstimmen. Wenn die Überschriften nicht übereinstimmen, passen Sie bitte die Spaltennamen entsprechend der obenstehenden Liste an, bevor Sie die Datei hochladen.</p>
            </div>
        </div>

    </div>
</div>