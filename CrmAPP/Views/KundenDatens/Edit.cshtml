@model CrmAPP.ViewModels.KundenEditViewModel

@{
    ViewBag.Title = "Edit";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .form-group {
        margin-bottom: 20px !important;
        width: 50% !important;
    }
</style>

@using (Html.BeginForm("Edit", "KundenDatens", FormMethod.Post, new { enctype = "multipart/form-data" }))
{
    @Html.AntiForgeryToken()

    <div class="card card-body">
        <div class="form-horizontal">
            <br />
            <h2>Kunden Daten</h2>
            <hr />
            <br />

            @Html.ValidationSummary(true, "", new { @class = "text-danger" })
            @Html.HiddenFor(model => model.Kunde.KundenDatenID)

            <div class="form-group  mt-lg-5">
                @Html.LabelFor(model => model.Kunde.Unternehmen, htmlAttributes: new { @class = "control-label col-md-2" })
                <div class="col-md-10 mb-3">
                    <div class="input-group">
                        <span class="input-group-text" style="background-color: #f1f1f1">
                            <i class='bx bx-building-house'></i>
                        </span>
                        @Html.EditorFor(model => model.Kunde.Unternehmen, new { htmlAttributes = new { @class = "form-control" } })
                    </div>
                    @Html.ValidationMessageFor(model => model.Kunde.Unternehmen, "", new { @class = "text-danger" })
                </div>
            </div>

            <div class="form-group mb-4">
                @Html.LabelFor(model => model.Kunde.Vorname, htmlAttributes: new { @class = "control-label col-md-2" })
                <div class="col-md-10 mb-lg-3">
                    <div class="input-group">
                        <span class="input-group-text" style="background-color: #f1f1f1">
                            <i class='bx bx-user'></i>
                        </span>
                        @Html.EditorFor(model => model.Kunde.Vorname, new { htmlAttributes = new { @class = "form-control" } })
                    </div>
                    @Html.ValidationMessageFor(model => model.Kunde.Vorname, "", new { @class = "text-danger" })
                </div>
            </div>

            <div class="form-group">
                @Html.LabelFor(model => model.Kunde.Nachname, htmlAttributes: new { @class = "control-label col-md-2" })
                <div class="col-md-10 mb-lg-5">
                    <div class="input-group">
                        <span class="input-group-text" style="background-color: #f1f1f1">
                            <i class='bx bx-id-card'></i>
                        </span>
                        @Html.EditorFor(model => model.Kunde.Nachname, new { htmlAttributes = new { @class = "form-control" } })
                    </div>
                    @Html.ValidationMessageFor(model => model.Kunde.Nachname, "", new { @class = "text-danger" })
                </div>
            </div>

            <!-- Bild -->
            <div class="mb-5 mt-lg-3 col-md-6 form-group">
                @if (!string.IsNullOrEmpty(Model.Kunde.Logo))
                {
                    <img id="pic1" src="@Url.Content("~/Logos/" + Model.Kunde.Logo)" alt="Logo" class="rounded" style="max-width: 150px; max-height: 150px; object-fit: cover !important; box-shadow: 10px 12px 15px rgba(0, 0, 0, 0.3)" />
                }
                else
                {
                    <span>Kein Bild</span>
                }
            </div>
            <div class="form-group ">
                @Html.Label("Logo", htmlAttributes: new { @class = "control-label col-md-2" })
                <div class="col-md-10 mb-lg-5">
                    <input type="file" name="Logo" accept="image/*" class="form-control" />
                    @Html.ValidationMessage("Logo", "", new { @class = "text-danger" })
                </div>
            </div>

            <div class="form-group">
                @Html.LabelFor(model => model.Kunde.Email, htmlAttributes: new { @class = "control-label col-md-2" })
                <div class="col-md-10 mb-lg-3">
                    <div class="input-group">
                        <span class="input-group-text" style="background-color: #f1f1f1">
                            <i class='bx bx-envelope' style="color: #dc3545;"></i>
                        </span>
                        @Html.EditorFor(model => model.Kunde.Email, new { htmlAttributes = new { @class = "form-control" } })
                    </div>
                    @Html.ValidationMessageFor(model => model.Kunde.Email, "", new { @class = "text-danger" })
                </div>
            </div>

            <div class="form-group">
                @Html.LabelFor(model => model.Kunde.TelefonMobil, htmlAttributes: new { @class = "control-label col-md-2" })
                <div class="col-md-10">
                    <div class="input-group">
                        <span class="input-group-text" style="background-color: #f1f1f1">
                            <i class='bx bx-phone'></i>
                        </span>
                        @Html.EditorFor(model => model.Kunde.TelefonMobil, new { htmlAttributes = new { @class = "form-control" } })
                    </div>
                    @Html.ValidationMessageFor(model => model.Kunde.TelefonMobil, "", new { @class = "text-danger" })
                </div>
            </div>

            <div class="form-group">
                @Html.LabelFor(model => model.Kunde.TelefonHaus, htmlAttributes: new { @class = "control-label col-md-2" })
                <div class="col-md-10">
                    <div class="input-group">
                        <span class="input-group-text" style="background-color: #f1f1f1">
                            <i class='bx bx-phone-call'></i>
                        </span>
                        @Html.EditorFor(model => model.Kunde.TelefonHaus, new { htmlAttributes = new { @class = "form-control" } })
                    </div>
                    @Html.ValidationMessageFor(model => model.Kunde.TelefonHaus, "", new { @class = "text-danger" })
                </div>
            </div>

            <div class="form-group">
                @Html.LabelFor(model => model.Kunde.ProjektAuftrag, htmlAttributes: new { @class = "control-label col-md-2" })
                <div class="col-md-10">
                    <div class="input-group">
                        <span class="input-group-text" style="background-color: #f1f1f1">
                            <i class='bx bx-briefcase'></i>
                        </span>
                        @Html.EditorFor(model => model.Kunde.ProjektAuftrag, new { htmlAttributes = new { @class = "form-control" } })
                    </div>
                    @Html.ValidationMessageFor(model => model.Kunde.ProjektAuftrag, "", new { @class = "text-danger" })
                </div>
            </div>

            <div class="form-group">
                @Html.LabelFor(model => model.Kunde.Website, htmlAttributes: new { @class = "control-label col-md-2" })
                <div class="col-md-10">
                    <div class="input-group">
                        <span class="input-group-text" style="background-color: #f1f1f1">
                            <i class='bx bx-world'></i>
                        </span>
                        @Html.EditorFor(model => model.Kunde.Website, new { htmlAttributes = new { @class = "form-control" } })
                    </div>
                    @Html.ValidationMessageFor(model => model.Kunde.Website, "", new { @class = "text-danger" })
                </div>
            </div>

            <div class="form-group">
                @Html.LabelFor(model => model.Kunde.Adresse, htmlAttributes: new { @class = "control-label col-md-2" })
                <div class="col-md-10">
                    <div class="input-group">
                        <span class="input-group-text" style="background-color: #f1f1f1">
                            <i class='bx bx-building-house' style="color: #6c757d;"></i><small class="text-muted">(Hauptsitz)</small>
                        </span>
                        @Html.EditorFor(model => model.Kunde.Adresse, new { htmlAttributes = new { @class = "form-control" } })
                    </div>
                    @Html.ValidationMessageFor(model => model.Kunde.Adresse, "", new { @class = "text-danger" })
                </div>
            </div>
            <br />

            <!-- Ansprechpartner -->
            <i>Kontaktpersonen</i>

            <div class="accordion accordion-popout col-md-8 mb-7 mt-3" id="accordionPopout">
                @if (Model.AnsprechpartnerList != null && Model.AnsprechpartnerList.Any())
                {
                    for (int i = 0; i < Model.AnsprechpartnerList.Count; i++)
                    {
                        string collapseId = "collapsePartner" + i;
                        string headingId = "headingPartner" + i;

                        <div class="accordion-item ">
                            <h2 class="accordion-header" id="@headingId">
                                <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#@collapseId" aria-expanded="false" aria-controls="@collapseId">
                                    <i style="margin-right:10px"> Kontaktperson</i> @(i + 1)
                                </button>
                            </h2>
                            <div id="@collapseId" class="accordion-collapse collapse" aria-labelledby="@headingId">
                                <div class="accordion-body">

                                    @Html.HiddenFor(m => m.AnsprechpartnerList[i].Id)
                                    @Html.HiddenFor(m => m.AnsprechpartnerList[i].KundenDatenID)

                                    <div class="mb-4 mt-4 col-md-5">
                                        <div class="input-group">
                                            <span class="input-group-text" style="background-color: #f1f1f1">
                                                <i class='bx bx-user' style="color:black"></i>
                                            </span>
                                            @Html.TextBoxFor(m => m.AnsprechpartnerList[i].Name, new { @class = "form-control", placeholder = "Vorname" })
                                        </div>
                                        @Html.ValidationMessageFor(m => m.AnsprechpartnerList[i].Name, "", new { @class = "text-danger" })
                                    </div>
                                    <div class="mb-4 col-md-7">
                                        <div class="input-group">
                                            <span class="input-group-text" style="background-color: #f1f1f1">
                                                <i class='bx bx-phone-call' style="color:#28a745"></i>
                                            </span>
                                            @Html.TextBoxFor(m => m.AnsprechpartnerList[i].Tel, new { @class = "form-control", placeholder = "Telefon" })
                                        </div>
                                        @Html.ValidationMessageFor(m => m.AnsprechpartnerList[i].Tel, "", new { @class = "text-danger" })
                                    </div>
                                    <div class="mb-4 col-md-9">
                                        <div class="input-group">
                                            <span class="input-group-text" style="background-color: #f1f1f1">
                                                <i class='bx bx-envelope' style="color:#ff4d4f"></i>
                                            </span>
                                            @Html.TextBoxFor(m => m.AnsprechpartnerList[i].Mail, new { @class = "form-control", placeholder = "E-Mail" })
                                        </div>
                                        @Html.ValidationMessageFor(m => m.AnsprechpartnerList[i].Mail, "", new { @class = "text-danger" })
                                    </div>
                                    <div class="mb-4 col-md-11">
                                        <div class="input-group">
                                            <span class="input-group-text" style="background-color: #f1f1f1">
                                                <i class='bx bx-map' style="color:#0d6efd"></i>
                                            </span>
                                            @Html.TextBoxFor(m => m.AnsprechpartnerList[i].Filiale, new { @class = "form-control ", placeholder = "Filiale/Location" })
                                        </div>
                                        @Html.ValidationMessageFor(m => m.AnsprechpartnerList[i].Filiale, "", new { @class = "text-danger" })
                                    </div>

                                </div>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="alert alert-warning mt-2 w-100">
                        Es gibt noch keinen Ansprechpartner für diesen Kunden.
                    </div>
                }
            </div>

        </div>

        <div class="form-group mt-lg-4">
            @Html.LabelFor(model => model.Kunde.Hinweise, htmlAttributes: new { @class = "control-label col-md-6" })
            <div class="col-md-11">
                <div class="input-group">
                    <span class="input-group-text " style="background-color: #f1f1f1"><i class='bx bx-notepad'></i></span>
                    @Html.TextAreaFor(model => model.Kunde.Hinweise, new { @class = "form-control col-md-12", rows = "6" })
                </div>
            </div>
            @Html.ValidationMessageFor(model => model.Kunde.Hinweise, "", new { @class = "text-danger" })
        </div>
        <br />
        <br />

        <div class="form-actions">
            <button type="submit" class="btn btn-warning" style=" border-radius:5px; padding:5px; padding-right:18px; color:black" title="Bearbeiten">
                <i class="bx bx-save" style="margin-left:9px; margin-right:7px; color:black"></i>
                Bearbeiten
            </button>
        </div>

    </div>
}

<hr />
<div>
    <div class="mt-2">
        <a href="/KundenDatens/Index" type="submit" class="btn btn-secondary" style=" font-size: 13px"><i class='bx bx-chevron-left' style=" margin-left:-10px"></i> Zurück zur Liste </a>
    </div>
</div>