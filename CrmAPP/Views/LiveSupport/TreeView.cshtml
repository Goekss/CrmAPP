<script>
    document.querySelectorAll('.tree .collapsible').forEach(function (folder) {
        folder.addEventListener('click', function (event) {
            event.stopPropagation(); // Alt öğelere bulaşmasın
            folder.classList.toggle('open');
        });
    });
</script>