                <li><span class="icon"><i class='bx bx-shield-x'></i></span>Blockierter Personal</li>
                <li><span class="icon"><i class='bx bxs-id-card'></i></span>Personal Cards</li>
            </ul>
        </li>

        <li class="collapsible">
