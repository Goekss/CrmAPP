@model IEnumerable<CrmAPP.Models.Projekt.Bericht>

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Berichts Liste";
}

<div class=" container-fluid ">
    <div class="row ">
        <div class="col-md-12 ">
            <!-- Header Section -->
            <div class="d-flex justify-content-between align-items-center mb-4 mt-5">
                <h2 class="mb-0">
                    <i class="fas fa-file-alt text-primary"></i> Berichts Liste

                </h2>
                @Html.ActionLink("Neuen Bericht erstellen", "Create", null, new { @class = "btn btn-primary" })
            </div>

            <!-- Success/Error Messages -->
            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    <i class="fas fa-check-circle"></i> @TempData["SuccessMessage"]
                    <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
            }

            @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    <i class="fas fa-exclamation-circle"></i> @TempData["ErrorMessage"]
                    <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
            }

            @if (ViewBag.Error != null)
            {
                <div class="alert alert-warning alert-dismissible fade show" role="alert">
                    <i class="fas fa-exclamation-triangle"></i> @ViewBag.Error
                    <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
            }

            <!-- Search and Filter Section -->
            <!-- Search and Filter Section -->
<div class="card mb-4">
    <div class="card-header">
        <h5 class="card-title mb-0">
            <i class="fas fa-search"></i> Suche und Filter
        </h5>
    </div>
    <div class="card-body">
        <form method="get" class="row g-3" action="@Url.Action("Index")">
            
            <!-- Arama Kutusu -->
            <div class="col-md-4">
                <label for="searchString" class="form-label">Titel, Kunde oder Projekt suchen</label>
                <input type="text" class="form-control" id="searchString" name="searchString"
                       value="@ViewBag.CurrentFilter" placeholder="Suchbegriff eingeben...">
            </div>

            <!-- Müşteri Filtresi -->
            <div class="col-md-3">
                <label for="kundenFilter" class="form-label">Kunde filtern</label>
                @{
                    // Controller'dan gelen listeyi güvenli bir şekilde al. Eğer null ise boş bir liste oluştur.
                    var kundenSelectList = ViewBag.KundenSelectList as List<SelectListItem> ?? new List<SelectListItem>();
                }
                <select class="form-control" id="kundenFilter" name="kundenFilter">
                    <option value="">Alle Kunden (@kundenSelectList.Count)</option>
                    @foreach (var kunde in kundenSelectList)
                    {
                        // Filtreleme sonrası seçili değeri koru.
                        var isSelected = kunde.Value == ViewBag.KundenFilter?.ToString();
                        <option value="@kunde.Value" selected="@isSelected">@kunde.Text</option>
                    }
                </select>
            </div>

            <!-- Proje Filtresi -->
            <div class="col-md-3">
                <label for="projektFilter" class="form-label">Projekt filtern</label>
                @{
                    // Controller'dan gelen proje listesini güvenli bir şekilde al.
                    var projektSelectList = ViewBag.ProjektSelectList as List<SelectListItem> ?? new List<SelectListItem>();
                }
                <select class="form-control" id="projektFilter" name="projektFilter">
                    <option value="">Alle Projekte (@projektSelectList.Count)</option>
                    @foreach (var projekt in projektSelectList)
                    {
                        // Filtreleme sonrası seçili değeri koru.
                        var isSelected = projekt.Value == ViewBag.ProjektFilter?.ToString();
                        <option value="@projekt.Value" selected="@isSelected">@projekt.Text</option>
                    }
                </select>
            </div>

            <!-- Butonlar -->
            <div class="col-md-2 d-flex align-items-end">
                <button type="submit" class="btn btn-info me-2">
                    <i class="fas fa-search"></i> Suchen
                </button>
                <a href="@Url.Action("Index")" class="btn btn-secondary">
                    <i class="fas fa-times"></i> Reset
                </a>
            </div>

        </form>
        
        <!-- Toplam Rapor Sayısını Gösteren Bilgi Satırı -->
        <div class="row mt-3">
            <div class="col">
                <p class="text-muted mb-0">
                    Total Berichte gefunden: @(Model?.Count() ?? 0)
                </p>
            </div>
        </div>

    </div>
</div>

            <!-- Reports Table -->
            <div class="card">
                <div class="card-header">
                    <h5 class="card-title mb-0">
                        <i class="fas fa-table"></i> Berichte Übersicht
                    </h5>


                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-striped table-hover mb-0">
                            <thead class="table-dark text-center">
                                <tr>
                                    <th>
                                        <i class="fas fa-building"></i>
                                        @Html.ActionLink("Kunde", "Index", new { sortOrder = ViewBag.KundeSortParm }, new { @class = "text-white text-decoration-none" })
                                    </th>
                                    <th>
                                        <i class="fas fa-project-diagram"></i>
                                        @Html.ActionLink("Projekt", "Index", new { sortOrder = ViewBag.ProjektSortParm }, new { @class = "text-white text-decoration-none" })
                                    </th>
                                    <th>
                                        <i class="fas fa-heading"></i>
                                        @Html.ActionLink("Titel", "Index", new { sortOrder = ViewBag.TitelSortParm }, new { @class = "text-white text-decoration-none" })
                                    </th>
                                    <th><i class="fas fa-download"></i> Datei</th>
                                    <th><i class="fas fa-file-code"></i> Typ</th>
                                    <th><i class="fas fa-code-branch"></i> Version</th>
                                    <th>
                                        <i class="fas fa-calendar"></i>
                                        @Html.ActionLink("Hochgeladen", "Index", new { sortOrder = ViewBag.DateSortParm }, new { @class = "text-white text-decoration-none" })
                                    </th>
                                    <th><i class="fas fa-user"></i> Von</th>
                                    <th><i class="fas fa-cogs "></i> Aktionen</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model != null && Model.Any())
                                {
                                    foreach (var item in Model)
                                    {
                                        <tr>
                                            <td>
                                                @if (!string.IsNullOrEmpty(item.Kunde?.Unternehmen))
                                                {
                                                    <strong>@item.Kunde.Unternehmen</strong>
                                                }
                                                else if (item.Kunde != null)
                                                {
                                                    <span>@($"{item.Kunde.Vorname} {item.Kunde.Nachname}".Trim())</span>
                                                }
                                                else
                                                {
                                                    <span class="text-muted">Unbekannt</span>
                                                }
                                            </td>
                                            <td>
                                                @if (!string.IsNullOrEmpty(item.Projekt?.Projektname))
                                                {
                                                    <span class="badge badge-info " style="color:black">@item.Projekt.Projektname</span>
                                                }
                                                else
                                                {
                                                    <span class="text-muted">Kein Projekt</span>
                                                }
                                            </td>
                                            <td>
                                                <strong>@(item.Titel ?? "Ohne Titel")</strong>
                                            </td>
                                            <td>
                                                @if (!string.IsNullOrEmpty(item.DateiPfad))
                                                {
                                                    @Html.ActionLink("Download", "Download", new { id = item.BerichtId }, new
                                                    {
                                                        @class = "btn btn-sm btn-info",
                                                        title = "Datei herunterladen",
                                                        target = "_blank"
                                                    })
                                                }
                                                else
                                                {
                                                    <span class="badge badge-warning">Keine Datei</span>
                                                }
                                            </td>
                                            <td>
                                                @if (!string.IsNullOrEmpty(item.DateiTuru))
                                                {
                                                    <span class="badge badge-secondary" style="color:black">@item.DateiTuru.ToUpper()</span>
                                                }
                                                else
                                                {
                                                    <span class="text-muted">-</span>
                                                }
                                            </td>
                                            <td>
                                                @if (!string.IsNullOrEmpty(item.Version))
                                                {
                                                    <code>@item.Version</code>
                                                }
                                                else
                                                {
                                                    <span class="text-muted">-</span>
                                                }
                                            </td>
                                            <td>
                                                @if (item.HochgeladenAm.HasValue)
                                                {
                                                    <small>
                                                        @item.HochgeladenAm.Value.ToString("dd.MM.yyyy")<br>
                                                        <span class="text-muted">@item.HochgeladenAm.Value.ToString("HH:mm")</span>
                                                    </small>
                                                }
                                                else
                                                {
                                                    <span class="text-muted">Unbekannt</span>
                                                }
                                            </td>



                                            <td>
                                                @if (item?.HochgeladenVon != null)
                                                {
                                                    <small>
                                                        <i class="fas fa-user-circle text-primary"></i>
                                                        @($"{item.HochgeladenVon.Vorname} {item.HochgeladenVon.Nachname}".Trim())
                                                    </small>
                                                }
                                                else
                                                {
                                                    <span class="text-warning">
                                                        <i class="fas fa-question-circle"></i> Unbekannt
                                                    </span>
                                                }
                                            </td>


                                            <td>
                                                <div class="btn-group active" role="group">
                                                    @Html.ActionLink("Details", "Details", new { id = item.BerichtId }, new
                                                    {
                                                        @class = "btn btn-sm btn-outline-secondary",
                                                        title = "Details anzeigen"
                                                    })
                                                    @Html.ActionLink("Bearbeiten", "Edit", new { id = item.BerichtId }, new
                                                    {
                                                        @class = "btn btn-sm btn-outline-warning",
                                                        title = "Bearbeiten"
                                                    })
                                                    @if (User.IsInRole("Admin") || User.IsInRole("Moderator"))
                                                    {
                                                        @Html.ActionLink("Löschen", "Delete", new { id = item.BerichtId }, new
                                                        {
                                                            @class = "btn btn-sm btn-outline-danger",
                                                            title = "Löschen",
                                                            onclick = "return confirm('Sind Sie sicher, dass Sie diesen Bericht löschen möchten?');"
                                                        })
                                                    }
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="9" class="text-center text-muted py-5">
                                            <i class="fas fa-inbox fa-3x mb-3 d-block"></i>
                                            <h5>Keine Berichte gefunden</h5>
                                            <p class="mb-0">Es wurden keine Berichte entsprechend Ihren Filterkriterien gefunden.</p>
                                            @Html.ActionLink("Ersten Bericht erstellen", "Create", null, new { @class = "btn btn-primary mt-3" })
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <!-- Statistics Card (Optional) -->
            @if (Model != null && Model.Any())
            {
                <div class="row mt-lg-5 mb-lg-5">
                    <div class="col-md-3">
                        <div class="card bg-primary text-white">
                            <div class="card-body">
                                <div class="d-flex justify-content-between">
                                    <div>
                                        <h4 class="card-title">@Model.Count()</h4>
                                        <p class="card-text">Gesamt Berichte</p>
                                    </div>
                                    <div class="align-self-center">
                                        <i class="fas fa-file-alt fa-2x"></i>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="card bg-success text-white">
                            <div class="card-body">
                                <div class="d-flex justify-content-between">
                                    <div>
                                        <h4 class="card-title">@Model.Count(b => b.HochgeladenAm >= DateTime.Now.AddDays(-7))</h4>
                                        <p class="card-text">Diese Woche</p>
                                    </div>
                                    <div class="align-self-center">
                                        <i class="fas fa-calendar-week fa-2x"></i>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="card bg-info text-white">
                            <div class="card-body">
                                <div class="d-flex justify-content-between">
                                    <div>
                                        <h4 class="card-title">@Model.GroupBy(b => b.KundenDatenId).Count()</h4>
                                        <p class="card-text">Aktive Kunden</p>
                                    </div>
                                    <div class="align-self-center">
                                        <i class="fas fa-users fa-2x"></i>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-3 ">
                        <div class="card bg-warning text-white">
                            <div class="card-body">
                                <div class="d-flex justify-content-between">
                                    <div >
                                        <h4 class="card-title">@Model.GroupBy(b => b.PerProjID).Count()</h4>
                                        <p class="card-text">Aktive Projekte</p>
                                    </div>
                                    <div class="align-self-center">
                                        <i class="fas fa-project-diagram fa-2x"></i>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</div>


<hr />

<div>
    <div class="mt-0">
        <a href="/Dashboard/Index/" class="btn btn-sm btn-secondary">
            <i class='bx bx-chevron-left' style="margin-left:-10px"></i> Zurück
        </a>
    </div>
</div>

<style>
    .table th {
        border-top: none;
        font-weight: 600;
        font-size: 0.9rem;
    }

    .btn-group .btn {
        margin-right: 2px;
    }

    .badge {
        font-size: 0.75rem;
    }

    .card {
        box-shadow: 0 0.125rem 0.25rem rgba(0, 0, 0, 0.075);
        border: 1px solid rgba(0, 0, 0, 0.125);
    }

    .table-hover tbody tr:hover {
        background-color: rgba(0, 123, 255, 0.05);
    }

    .alert {
        border: none;
        border-radius: 0.5rem;
    }

    @@media (max-width: 768px) {
        .btn-group {
            flex-direction: column;
        }

            .btn-group .btn {
                margin-bottom: 2px;
                margin-right: 0;
            }
    }
</style>

<script>
    $(document).ready(function () {
        // Auto-dismiss alerts after 5 seconds
        setTimeout(function () {
            $('.alert').fadeOut('slow');
        }, 5000);

        // Tooltip initialization
        $('[title]').tooltip();

        // Confirm deletion
        $('.btn-outline-danger').click(function (e) {
            if (!confirm('Sind Sie sicher, dass Sie diesen Bericht löschen möchten?')) {
                e.preventDefault();
                return false;
            }
        });
    });
</script>