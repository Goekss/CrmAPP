<script>
    function decreaseValue() {
        const slider = document.getElementById('slider');
        let value = parseInt(slider.value);
        if (value > parseInt(slider.min)) {
            slider.value = value - 1;
            Prozentbearbeitung(slider);
        }
    }
    function increaseValue() {
        const slider = document.getElementById('slider');
        let value = parseInt(slider.value);
        if (value < parseInt(slider.max)) {
            slider.value = value + 1;
            Prozentbearbeitung(slider);
        }
    }
    function Prozentbearbeitung(element) {
        const text = document.getElementById('sliderValue');
        text.innerHTML = " % " + element.value;
    }
    function setSliderValue(value) {
        const slider = document.getElementById('slider');
        slider.value = value;
        Prozentbearbeitung(slider);
        clearOtherCheckboxes(value);
    }
    function clearOtherCheckboxes(checkedValue) {
        const checkboxes = [
            { id: 'checkbox1', value: 1 },
            { id: 'checkbox2', value: 25 },
            { id: 'checkbox3', value: 50 },
            { id: 'checkbox4', value: 75 },
            { id: 'checkbox5', value: 100 }
        ];
        checkboxes.forEach(checkbox => {
            if (checkbox.value !== checkedValue) {
                document.getElementById(checkbox.id).checked = false;
            }
        });
    }
    document.addEventListener('DOMContentLoaded', function () {
        const projektStatus = parseInt("@Model.ProjektStatus");
        function updateProgressCircle(value) {
            const progressCircle = document.getElementById('progressCircle');
            const circleText = document.getElementById('circleText');
            const radius = 45;
            const circumference = 2 * Math.PI * radius;
            const offset = circumference - (value / 100) * circumference;
            progressCircle.style.strokeDashoffset = offset;
            circleText.innerHTML = value + "%";
        }
        updateProgressCircle(projektStatus);
    });
</script>
<script>
    function uploadFile() {
        var fileInput = document.getElementById('report-file');
        var fileList = document.getElementById('uploaded-files');
        if (fileInput.files.length === 0) {
            alert("Lütfen bir dosya seçin!");
            return;
        }
        for (var i = 0; i < fileInput.files.length; i++) {
            var file = fileInput.files[i];
            var fileName = file.name;
            var fileUrl = URL.createObjectURL(file);
            var now = new Date();
            var uploadDate = now.toLocaleString();
            var listItem = document.createElement("li");
            listItem.className = "list-group-item";
            listItem.setAttribute("data-upload-date", uploadDate);
            listItem.innerHTML = `
            <div  style="display: flex; flex-direction: column; flex-grow: 1; color: dimgray; overflow: hidden;">
                <span style="font-weight: bold; overflow: hidden; text-overflow: ellipsis;">${fileName}</span>
                <small style="color: gray;">📅 Hochgeladen am: <um style="color:blue">${uploadDate}</um> </small>
            </div>
            <div style="display: flex; justify-content: flex-end; gap: 3px; max-width: 100%;">
                <a href="${fileUrl}" download="${fileName}" class="btn btn-sm btn-success"><i class='bx bx-download'></i></a>
                <button class="btn btn-sm btn-danger" onclick="deleteFile(this)"><i class='bx bxs-trash'></i></button>
            </div>
        `;
            fileList.appendChild(listItem);
        }
        fileInput.value = "";
    }
    function deleteFile(button) {
        var listItem = button.parentElement.parentElement;
        var fileName = listItem.querySelector('span').textContent.trim();
        var uploadDate = listItem.getAttribute("data-upload-date");
        var now = new Date();
        var deleteDate = now.toLocaleString();
        listItem.innerHTML = `
        <div style="display: flex; flex-direction: column;shadow: rgba(149, 157, 165, 0.2) 0px 8px 24px;">
            <span style="font-weight: bold;color:#DCDCDC">${fileName}</span>
            <small style="color:red;opacity:0.5">📅 Hochgeladen am: ${uploadDate}</small>
            <small style="color:red;opacity:0.5">❌ Gelöscht am: ${deleteDate}</small>
        </div>
    `;
        button.disabled = true;
        button.style.visibility = 'hidden';
    }
</script>