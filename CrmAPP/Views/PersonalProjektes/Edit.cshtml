<br />
<h2>Projekt Bearbeiten</h2>
<hr />

<div id="bigcon" class="content-wrapper col-xxl-12" >
    <div class="container-xxl  flex-grow-1 container-p-y" >
        <div class="row g-6">
            @using (Html.BeginForm("Edit", "PersonalProjektes", FormMethod.Post, new { enctype = "multipart/form-data" }))
