                                var musteri = Model.KundenDatens?.FirstOrDefault();
                            }
                            @if (musteri != null)
                            {
                                <div style="margin-bottom:15px;">
                                    <img src="@Url.Content("~/Logos/" + musteri.Logo)" class="rounded" style="max-width: auto; max-height: 75px; margin-left: 15px; box-shadow: 5px 6px 7px rgba(0, 0, 0, 0.3);" />
                                    <span style="color: black; margin-left: 10px;">@musteri.Unternehmen</span>
                                    <input type="hidden" name="SelectedKundenId" value="@musteri.KundenDatenID" />
                                </div>
                            }
                            else
                            {
                                <div class="alert-warning w-25" style="margin-left:10px">Keine Kundeninformation!</div>
                            }
                        </div>



                        <!-- ====  ANSPRECHPARTNER  ==== -->
                        @if (User.IsInRole("Admin") || User.IsInRole("Moderator"))
                        {
                            <div class="card-body">
                                @{
                                    var ansprechpartnerList = ViewBag.AnsprechpartnerList as List<CrmAPP.Models.Kunden.Ansprechpartner>;
                                    var selectedAnsprechpartnerIds = Model.SelectedAnsprechpartnerIds ?? new List<int>();
                                }
                                <div class="card-body">
                                    <div class="mb-0 mt-4">
                                        <u class="form-label fw-bold " style="margin-left:10px">Ansprechpartner*in</u>
                                        @if (ansprechpartnerList?.Any() == true)
                                        {
                                            <div class="ansprechpartner-list mt-3 " style="margin-left:10px">
                                                @foreach (var ans in ansprechpartnerList)
                                                {
                                                    <div class="form-check mb-3">
                                                        <input class="form-check-input"
                                                               type="checkbox"
                                                               name="SelectedAnsprechpartnerIds"
                                                               value="@ans.Id"
                                                               id="ans_@ans.Id"
                                                               @(selectedAnsprechpartnerIds.Contains(ans.Id) ? "checked" : "") />
                                                        <label class="form-check-label" for="ans_@ans.Id">
                                                            <b>@ans.Name</b>
                                                            <span class="text-muted small">
                                                                ( <i class="bx bx-phone-call" style="color: #28a745;"></i>: @ans.Tel,
                                                                <i class="bx bx-envelope" style="color: #ff4d4f; margin-left: 14px"></i>: @ans.Mail,
                                                                <i class="bx bx-building-house" style="color: lightslategray; margin-left: 14px"></i>: @ans.Filiale )
                                                            </span>
                                                        </label>
                                                    </div>
                                                }
                                            </div>
                                        }
                                        else
                                        {
                                            <div class="alert-warning w-25" style="margin-left:10px"> Keine Informationen über die Kontaktpersonen !</div>
                                        }
                                    </div>
                                </div>
                                <hr class="w-50 mt-1" />

                                @{
                                    var personalList = ViewBag.PersonalDatenID as SelectList;
                                    // Hangileri seçili? Eğer Model.SelectedPersonalIds yoksa ViewBag.SelectedPersonalIds kullan
                                    var selectedPersonalIds = Model.SelectedPersonalIds ?? ViewBag.SelectedPersonalIds as List<int> ?? new List<int>();
                                }

                                <!--=== Personal === -->
                                <div class="card-body accordion-item ">
                                    <div>
                                        <!-- Collapse Toggle Button -->
                                        <button style="background-color:whitesmoke" class="accordion-button collapsed w-50" type="button" data-bs-toggle="collapse" data-bs-target="#personalCollapse" aria-expanded="true" aria-controls="personalCollapse">
                                            <u class="form-label fw-bold ">zugewiesene Personal</u>
                                        </button>

                                        <!-- Collapse Area -->
                                        <div id="personalCollapse" class="accordion-collapse collapse ">
                                            <div class="row mt-4  ">
                                                @if (personalList != null)
                                                {
                                                    foreach (var personel in personalList)
                                                    {
                                                        var isChecked = selectedPersonalIds.Contains(Convert.ToInt32(personel.Value));
                                                        <div class="form-check mb-2 col-md-2 col-6 mb-3 gap-2 " style="margin-left:20px">
                                                            <input class="form-check-input "
                                                                   type="checkbox"
                                                                   name="SelectedPersonalIds"
                                                                   value="@personel.Value"
                                                                   id="personal_@personel.Value"
                                                                   @(isChecked ? "checked" : "") />
                                                            <label class="form-check-label" for="personal_@personel.Value">
                                                                @personel.Text
                                                            </label>
                                                        </div>
                                                    }
                                                }
                                                else
                                                {
                                                    <div class="alert alert-warning">Keine Infos!</div>
                                                }
                                            </div>
                                        </div>
                                    </div>
                                </div>

                            </div>
                        }

                        else
                        {
                            <div style="margin-left:50px!important" class="mb-0"><small> <i class='bx bx-key'></i> </small></div>
                        }



                        <hr class="w-100 mt-1" />
                        <div class="card-header ">
                            @Html.HiddenFor(m => m.PerProjID)
                        </div>
                        <div class="card-body" style="display: flex; justify-content: space-between; align-items: flex-start;">
                            <!--Sol Blok-->
                            <div style="width: 40%;">
                                <!--Projekt Titel-->
                                <div class="mb-3" style="width:100% !important">
                                    <label class="form-label" for="Projektname">Projekt Titel</label>
                                    <input class="form-control" name="Projektname" type="text" maxlength="30" value="@Model.Projektname" />
                                </div>
                                <br />
                                <!--Projekt Beschreibung-->
                                <div style="width:100% !important">
                                    <label class="form-label" for="Erklärung">Beschreibung</label>
                                    <input id="basic-default-message" class="form-control" name="Erklärung" maxlength="70" value="@Model.Erklärung">
                                </div>
                                <br />
                                <br />
                                <!--Projekt Abschlussquote-->
                                <label id="barlabel" class="form-label">Projektabschluss </label>
                                <div id="bars" class="progress-bar-animated" style="display: flex; align-items: center;height:40px;width:100%!important ">

                                    <button type="button" onclick="decreaseValue()" style="margin-right: 5px; background-color: orange; border: unset; border-radius: 10px 0px 0px 10px !important">-</button>
                                    <input id="slider" name="ProjektStatus" value="@Model.ProjektStatus" type="range" min="0" max="100" style="width: 70%" oninput="Prozentbearbeitung(this)" />

                                    <button type="button" onclick="increaseValue()" style="margin-left: 5px; background-color: orange; border: unset; border-radius: 0px 10px 10px 0px !important">+</button>
                                    <span id="sliderValue" style="margin-left:15px !important;font-size:12px !important;color:#000000 !important">  @Model.ProjektStatus %</span>
                                </div>
                                <br />

                                <!--Rund-Diagramm-->
                                <div style=" margin-left:20px!important">
                                    <i class="zustand"> Derzeitige Abschlussquote </i>
                                    <div id="circleContainer" style="position: relative; width: 100px; height: 100px;">
                                        <svg width="100" height="100">
                                            <circle cx="50" cy="50" r="45" stroke="silver" stroke-width="10" fill="none" />
                                            <circle id="progressCircle" cx="50" cy="50" r="45" stroke="orange" stroke-width="10" fill="none"
                                                    stroke-dasharray="283" stroke-dashoffset="283" transform="rotate(-90 50 50)" />
                                        </svg>
                                        <div id="circleText" style="color:black;position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); font-size: 14px;">@Model.ProjektStatus %</div>
                                    </div>
                                </div>
                                <br />

                                <!--Checkboxen-->
                                <div id="prginfo" style="max-width:100%">
                                    <div id="barscheck" class="progress-bar-animated">
                                        <!-- 5 Kademeli Checkbox -->
                                        <label class="cbx"><input type="checkbox" id="checkbox1" onclick="setSliderValue(1)"> (0-20 %) Start</label>
                                        <label class="cbx"><input type="checkbox" id="checkbox2" onclick="setSliderValue(25)"> (20-40 %) Vorbereitung</label>
                                        <label class="cbx"><input type="checkbox" id="checkbox3" onclick="setSliderValue(50)"> 40-60% Nachbesprechung</label>
                                        <label class="cbx"><input type="checkbox" id="checkbox4" onclick="setSliderValue(75)"> 60-80% Abschluss</label>
                                        <label class="cbx"><input type="checkbox" id="checkbox5" onclick="setSliderValue(100)"> 80-100% Nacharbeit</label>
                                    </div>
                                </div>

                                <br />
                                <br />

                                <!--Priorität-->
                                <div class="mb-3 col-md-6" style="width:100% !important;">
                                    <label class="form-label" for="Priorität">Priorität</label>
                                    <select name="Priorität" class="form-control">
                                        <option value="high" @(Model.Priorität == "high" ? "selected" : "")>» High Priorität (⭐⭐⭐)</option>
                                        <option value="middle" @(Model.Priorität == "middle" ? "selected" : "")>» Middle Priorität (⭐⭐)</option>
                                        <option value="low" @(Model.Priorität == "low" ? "selected" : "")>» Low Priorität (⭐)</option>
                                    </select>
                                    <!-- Debug için -->
                                    <small class="text-muted">Priorität Werte war: @Model.Priorität</small>
                                </div>
                               
                            </div>
                        </div>

                        <hr />
                        <!-- BERICHT -->
                        
                        <!--<div class="card-body" style="background-image: url('@Url.Content("~/THEMA/assets/img/elements/LoginImgEd2.jpg")')">
                            
