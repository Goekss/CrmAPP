@model CrmAPP.Models.Projekt.PersonalProjekte

@{
    ViewBag.Title = "Edit Project";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!-- pdfmake ve vfs_fonts  -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.1.36/pdfmake.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.1.36/vfs_fonts.js"></script>
<script src='https://unpkg.com/boxicons@latest/dist/boxicons.js'></script>

<style>
    .mycontainer {
        width: 50px;
        float: left;
        padding-left: 30px;
        padding-top: 30px;
        border-radius: 10px;
        display: table;
        background-color: cadetblue;
        color: white;
    }

    .mycontainer2 {
        width: 20%;
        padding-left: 25px;
        float: left;
        display: table;
    }

    #hnws {
        margin-left: 20px;
        border: 1px solid #898484;
        border-radius: 10px;
        font-size: 10px;
        padding: 10px;
        width: 160px;
        height: 80px;
        text-align: justify;
        float: left;
        opacity: 0.7;
    }

    #bars {
        background-color: lightgray !important;
        width: 60%;
        border-radius: 10px;
        height: 30px !important;
        padding-left: 20px !important;
    }

    .ansprechpartner-list {
        display: flex;
        flex-wrap: wrap; /* Satır sonuna gelince alta geçmesini sağlar */
        gap: 5px 55px;
    }

    .form-check-label > b {
        margin-right: 7px;
    }

    #prginfo {
        display: flex;
        align-items: center;
        gap: 20px;
    }

    .cbx {
        height: 32px !important;
        margin-left: 15px !important;
        padding-right: 40px;
        width: 100%;
        white-space: nowrap;
    }

    #barscheck {
        border-radius: 10px;
        display: grid;
        align-items: center;
        height: 150px;
        padding-right: 0px !important;
    }

    .zustand {
        width: 110px;
        margin-top: -100px;
        margin-right: -30px;
        padding-left: 0px;
        padding-bottom: 10px !important;
        color: black;
        font-size: 10px;
    }

    @@media (max-width: 768px) {
        #bigcon {
            width: 100% !important;
            padding: 10px;
        }
    }

    @@media (max-width: 480px) {
        #bigcon {
            width: 100% !important;
            padding: 5px;
            display: block;
            overflow-x: hidden;
        }

        .card-body {
            min-width: auto !important;
            width: 100% !important;
            overflow-x: hidden;
        }

        #uploaded-files {
            max-width: 100% !important;
            overflow-x: auto;
            word-wrap: break-word;
        }
    }

    #frma {
        text-align: right;
        margin: 30px !important;
        height: 75px !important;
        background-color: #ececec;
        border-radius: 8px !important;
        background: rgb(235,235,235);
        background: linear-gradient(90deg, rgba(235,235,235,1) 5%, rgba(244,244,244,0) 94%);
        margin-top: 60px !important;
    }
  
</style>

