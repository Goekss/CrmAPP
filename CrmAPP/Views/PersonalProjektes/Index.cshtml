<style>
    #h5 {
        color: cadetblue;
        padding-bottom: 20px !important;
        margin-top: -10px !important;
        margin-left: -30px !important;
    }

    #sm { /*Überblick über die laufenden Projekte*/
        margin-top: 10px !important;
        max-width: 100% !important;
        padding-right: 25px !important;
        text-align: right;
        color: darkcyan !important;
    }



    #projektliste_info { /*_TOTAL_ Eintrag von _START_ bis _END_ werden angezeigt.*/
        margin-left: 10px !important;
        padding-top: 50px !important;
        opacity: 0.5 !important;
        font-size: 10px !important;
    }

    #projektliste_filter { /*Search:Div*/
        padding-right: 0px !important;
        font-size: 10px !important;
    }

    div.dataTables_wrapper div.dataTables_filter input { /*Search:Suchleiste*/
        width: auto !important;
        height: 20px !important;
        border-radius: 10px !important;
    }

    .pagination { /*buttons Vorherige -Nächste*/
        padding-right: 20px !important;
        padding-bottom: 10px !important;
        font-size: 12px !important;
        filter: drop-shadow( 4px 2px 4px rgba(0,0,0,0.3)) !important; /*Der Schatten ist nach links angelehnt.*/
    }

    .dt-buttons .buttons-print, .dt-buttons .buttons-copy, .dt-buttons .buttons-excel, .dt-buttons .buttons-pdf { /*PDF-EXCEL-DRUCKEN btn-group*/
        background-color: cadetblue; /*- Hintergrundfarbe */
        color: white; /* Textfarbe */
        opacity: 0.8 !important;
        font-size:15px!important;
    }

    .page-item.active .page-link, .page-item.active .page-link:hover, .page-item.active .page-link:focus, .pagination li.active > a:not(.page-link), .pagination li.active > a:not(.page-link):hover, .pagination li.active > a:not(.page-link):focus { /* vorherige [1-2]btn nächste*/
        background-color: cadetblue !important;
    }

    table.dataTable.dtr-inline.collapsed > tbody > tr > td:first-child:before, table.dataTable.dtr-inline.collapsed > tbody > tr > th:first-child:before {
        background-color: orange !important;
        margin-left: 14px !important;
        margin-top: 10px !important;
    }


    .btn-group { /*Excel-PDF-Drucken*/
        padding-top: 25px !important;
        padding-bottom: 30px !important;
        padding-left: 10px !important;
        filter: drop-shadow( 4px 4px 8px rgba(0,0,0,0.3)) !important; /*Der Schatten ist nach links angelehnt.*/
    }

    thead {
        background-color: #2c5e77 !important;
        padding-top: 20px !important;
        text-align: right !important;
    }

    th {
        color: white !important;
        text-align: center !important;
    }

    td {
        text-align: center !important;
    }

    table.dataTable tbody td:nth-child(1) {
        /*Ein-Ausblenden + button */
        text-align: left !important;
    }

    table.dataTable tbody td {
        vertical-align: middle; /* Dikey ortalama */
        text-align: center;
        padding: 10px; /* Hücre içi boşluk */
        font-size: 10px !important;
    }

    #projektliste {
        table-layout: fixed !important;
    }

    /*CardBody*/
    .card {
        filter: drop-shadow( 4px 4px 8px rgba(0,0,0,0.3)) !important; /*Der Schatten ist nach links angelehnt.*/
    }

    .table-hover tbody tr:hover {
        background-color: #ffffff /* Mavi renk */
    }



    @@media (max-width: 1112px) {
    .avatar-group  {
        flex-direction: row !important;
        flex-wrap: wrap !important;
        justify-content: center !important;
        padding: 6px !important;
       
    }

    .avatar-group .avatar {
        margin: 4px !important;
    }

    .avatar-group .avatar img {
        width: 32px !important;
        height: 32px !important;
    }


}
