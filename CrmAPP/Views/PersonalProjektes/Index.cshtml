<div class="card " >

    <div class="card-header d-flex justify-content-between align-items-center" style="background-color:#90909031 !important">
        <h5 id="h5" class="card-header"><b>PROJEKTGALERIE</b></h5>
        @* --- YENİ EKLENEN İKONLU BUTON --- *@
        @{
            var userRoles = User.IsInRole("Admin") || User.IsInRole("Moderator");
        }

        @if (userRoles)
        {
            <a href="@Url.Action("Import")" class="btn btn-success">
                <i class='bx bxs-file-import'></i> von Excel importieren
            </a>
        }
    </div>
    <small id="sm" class="text-muted float-end" style="opacity:0.5; font-size:9px;float:right!important"> Überblick über die laufenden Projekte</small>

    <div class="card-body">
        <div class="table-responsive overflow-auto">
            <table id="projektliste" class="table table-hover table-borderless " style="font-size:5px !important; ">
                <thead class="table table-borderless " style="min-width: 900px; ">
                    <tr style="text-align:center !important" cellspacing="40">
                        <th>↓</th>
                        <th>Projekt</th>
                        <th>Unternehmen</th>
                        <th>Priorität</th>
                        <th> % Rank</th>
                        <th>End-datum</th>
                        <th>Beauftragten</th>
                        <th>Fertigstellen</th>
                        <th>Aktion</th>
                        <th>Inhalt</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>
                            </td>
                            <td>
                                <b style="font-size:10px;margin-right:10px">@item.Projektname</b>
                            </td>
                            @*<td><span class="badge bg-label-secondary me-3">@item.Startdatum</span></td>*@
                            <td>
                                <div style="display: block;">
                                    @foreach (var x in item.KundenDatens)
                                    {
                                        <div style=" padding: 1px !important; display: flex; align-items: center;">
                                            <img src="@Url.Content("~/Logos/" + x.Logo)" title="@x.Unternehmen" class="rounded" style="max-width: 40px; max-height: 40px;min-width:40px!important;min-height:40px!important; margin-right: 5px;">
                                            <span style="flex-grow: 1; text-align: center; font-family:'Franklin Gothic Medium', 'Arial Narrow', Arial, sans-serif">@x.Unternehmen</span>
                                        </div>
                                    }
                                </div>
                            </td>
                            @functions {
                                public string GetPrioritätText(string value)
                                {
                                    switch (value)
                                    {
                                        case "prio-h":
                                        case "high":
                                            return "⭐⭐⭐";
                                        case "prio-m":
                                        case "middle":
                                            return "⭐⭐";
                                        case "prio-l":
                                        case "low":
                                            return "⭐";
                                        default:
                                            return "Priorität";
                                    }
                                }
                            }
                            <td>
                                @if (item.Priorität == "prio-l" || item.Priorität == "low")
                                {
                                    
                                        @GetPrioritätText(item.Priorität)
                                    
                                }
                                else if (item.Priorität == "prio-m" || item.Priorität == "middle")
                                {
                                    
                                        @GetPrioritätText(item.Priorität)
                                   
                                }
                                else if (item.Priorität == "prio-h" || item.Priorität == "high")
                                {
                                    
                                        @GetPrioritätText(item.Priorität)
                                    
                                }
                               
                            </td>
                            <td>
                                <div class="progress" style="margin-bottom:0;max-width:90%;height:11px">
                                    <div class="progress-bar"
                                         role="progressbar"
                                         style="background-color:orange;color:rgb(65, 65, 65);font-size:11px;width:@item.ProjektStatus%;"
                                         aria-valuenow="@item.ProjektStatus"
                                         aria-valuemin="0"
                                         aria-valuemax="100">
                                        @item.ProjektStatus%
                                    </div>
                                </div>
                            </td>
                            <td style="color:darkgreen !important">
                                @if (item.Enddatum.HasValue)
                                {
                                    @item.Enddatum.Value.ToString("dd.MM.yyyy") <!-- Wird im Format Tag-Monat-Jahr angezeigt -->
                                }
                                else
                                {
                                    <span style="color:red !important">kein Enddatum</span>
                                }
                            </td>
                            <td class="table-responsive-sm">
                                <ul class="list-unstyled m-0 avatar-group d-flex align-items-center" @*style="background-color: white;max-width:90%!important;border-radius:12px!important;"*@>
                                    @foreach (var y in item.PersonalAngabens)
                                    {
                                        <li class="avatar avatar-xs pull-up" title="@y.Vorname @y.Nachname">
                                            <img src="@Url.Content("~/Images/"+ y.Bild)" class="rounded-circle" alt="Avatar" title="@y.Vorname @y.Nachname " >
                                        </li>
                                    }
                                </ul>
                            </td>
                            <td>
                                @if (item.ProjektStatus != 100)
                                {
                                    <span class="badge bg-label-danger me-3" style="width:90px!important"><i style="font-size:15px!important">x</i></span>
                                }
                                else if (item.ProjektStatus < 100)
                                {
                                    <!-- Wenn der Projektstatus kleiner als 100 ist, wird das rote Symbol wieder angezeigt. -->
                                    <span class="badge bg-label-danger me-3" style="width:90px!important"><i style="font-size:15px!important">x</i></span>
                                }
                                else
                                {
                                    <span class="badge bg-label-success me-3" style="width:90px!important"><i style="font-size:15px!important;color:green !important">✓ </i></span>
                                }
                            </td>
                            <td>
                                <div class="dropdown">
                                    <button type="button" class="btn p-0 dropdown-toggle hide-arrow" data-bs-toggle="dropdown">
                                        <i class="bx bx-dots-vertical-rounded"></i>
                                    </button>
                                    <div class="dropdown-menu " style="border-radius: 10px !important; box-shadow: 6px 6px 10px 0px rgba(0, 0, 0, 0.2);">
                                        <a class="dropdown-item" href="/PersonalProjektes/Edit/@item.PerProjID"><i class="bx bx-edit-alt me-1" style="color:darkorange"></i> Bearbeiten</a>
                                        <a class="dropdown-item" href="/PersonalProjektes/Beenden/@item.PerProjID"
                                           @if (item.ProjektStatus != 100) { @: onclick="event.preventDefault(); var audio = new Audio('/THEMA/klang_datei/error-sound2.mp3'); audio.play(); { setTimeout(function () { alert('\n 🛑  Vorsicht    \n \n Beachten Sie darauf;\n\n Das Projekt kann nur abgeschlossen werden,\n wenn es zu 100% erreicht hat.  '); }, 500); };"
                                           }>
                                            <i class="bx bx-check-double me-1" style="color:#0eeb10"></i> Abschließen
                                        </a>
                                        <a class="dropdown-item" href="/PersonalProjektes/Details/@item.PerProjID"><i class="bx bx-message-square-detail" style="color:#1656fe;margin-right:8px!important"></i> Details </a>
                                    </div>
                                </div>
                            </td>
                            <td>@item.Erklärung</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>


<!--  pdfmake- und vfs_fonts-Dateien  -->
