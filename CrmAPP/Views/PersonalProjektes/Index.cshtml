<script>
    $(document).ready(function () { // es zeigt Mitarbeiter-Name in aller Seite an.
        $('[data-bs-toggle="tooltip"]').tooltip(); // İlk yüklemede
    });

    // Sayfa geçişi veya tablo güncellemesinde tetiklenmesi gereken event
    $(document).on('draw.dt', function () {
        $('[data-bs-toggle="tooltip"]').tooltip(); // Yeniden başlat
    });

    document.querySelectorAll('.progress-bar').forEach(bar => {
        const status = bar.getAttribute('aria-valuenow');
        bar.style.width = `${status}%`;
    });

</script>
<script>
    // Sayfa yüklendikten sonra çalışacak olan fonksiyon
    window.addEventListener('load', function () {
        updateProgressBars(); // Sayfa yüklendikten sonra çalıştırılacak fonksiyon
    });

    // Sayfa geçişinde çubuğu güncelle
    function updateProgressBars() {
        // .progress-bar sınıfındaki tüm elemanları seç ve her birini işle
        document.querySelectorAll('.progress-bar').forEach(function (bar) {
            var status = bar.getAttribute('aria-valuenow');
            if (status) {
                bar.style.width = status + '%';  // Genişliği status ile güncelle
                bar.textContent = status + '%';  // Yüzdeyi metin olarak göster
            }
        });
    }

    // AJAX işleminden sonra sayfa içeriği güncellendiğinde
    // Sayfalandırma ya da içerik değişimi sonrasında çalışacak
    $(document).on('ajaxComplete', function () {
        updateProgressBars();  // AJAX işlemi tamamlandığında çalıştırılır
    });

    // Eğer sayfalandırma linkleri varsa, linklerin AJAX ile yüklenmesini sağlamak için
    // jQuery'nin $(document).on ile sayfa yüklemeleri sırasında updateProgressBars()'ı çağırabilirsiniz.
    $(document).on('click', '.pagination a', function (e) {
        e.preventDefault();  // Sayfa yenilenmesini engelle
        var url = $(this).attr('href');  // Tıklanan sayfa linkini al
        $.get(url, function (data) {
            $('#content').html(data);  // Sayfanın içeriğini güncelle (örneğin, #content ID'li eleman)
            updateProgressBars();  // İçerik yüklendikten sonra ilerleme çubuklarını güncelle
        });
    });
</script>



