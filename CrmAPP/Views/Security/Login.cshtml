@model CrmAPP.ViewModels.LoginViewModel


@{
    Layout = null;
}


<link href="//netdna.bootstrapcdn.com/bootstrap/3.0.0/css/bootstrap.min.css" rel="stylesheet" id="bootstrap-css" />
<script src="//netdna.bootstrapcdn.com/bootstrap/3.0.0/js/bootstrap.min.js"></script>
<script src="//code.jquery.com/jquery-1.11.1.min.js"></script>


<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>Login</title>
    <link href="~/Content/bootstrap.min.css" rel="stylesheet" />


    <style>
        @@import url('https://fonts.googleapis.com/css2?family=Comfortaa&display=swap');

        body {
            background: #e0e0e0;
            padding-top: 100px;
            font-family: 'Comfortaa', cursive;
        }

        #err {
            color: red;
            font-size: 10px !important;
            text-align: center;
            font-family: 'Comfortaa', cursive;
        }

        .login {
            width: 300px;
            padding: 8% 0 0;
            margin: auto;
            font-family: 'Comfortaa', cursive;
            border-radius: 50px;
        }

        .toggle-password {
            position: absolute;
            top: 65%;
            right: 15px;
            transform: translateY(-50%);
            cursor: pointer;
            color: dimgray;
            font-size: 10px;
            z-index: 1;
        }

        #btns {
            font-family: 'Comfortaa', cursive;
            text-transform: uppercase;
            outline: 0;
            background: #D4D4D4; /* alte Farbecode #e0e0e0*/
            margin-top: 25px;
            width: 100%;
            border: 0;
            border-radius: 5px;
            padding: 15px;
            color: dimgray;
            font-size: 10px;
            -webkit-transition: all 0.3ms ease;
            transition: all 0.3s ease;
            cursor: pointer;
        }

            #btns:hover {
                background-color: cadetblue !important;
                color: white;
            }

        .form {
            position: relative;
            z-index: 1;
            background: #FFFFFF;
            border-radius: 10px;
            max-width: 600px;
            max-height: 400px !important;
            margin: 0 auto 80px;
            padding: 45px;
            text-align: center;
            border-radius: 50px;
            background: #e0e0e0;
            box-shadow: -11px 11px 22px #bebebe, 11px -11px 22px #ffffff;
        }

            .form input {
                outline: none !important;
                background: #e0e0e0;
                width: 100%;
                border: 0;
                border-radius: 5px;
                margin: 0 0 15px;
                padding: 15px;
                box-sizing: border-box;
                font-size: 10px;
                font-family: 'Comfortaa', cursive;
            }

                .form input:focus {
                    background: #e9e9e9;
                    box-shadow: inherit;
                }

        @@keyframes spin {
            0% {
                transform: rotate(0deg);
            }

            100% {
                transform: rotate(360deg);
            }
        }

        .form button:active, .form button::after {
            background-color: cadetblue !important;
        }

        /* Tablet ve daha küçük cihazlar */
        @@media (max-width: 768px) {
            .login {
                width: 75%;
                padding: 10% 0 0;
            }

            .form {
                padding: 30px;
            }

            #btns {
                padding: 12px;
                font-size: 9px;
            }

            .form input {
                padding: 12px;
                font-size: 9px;
            }
        }

        /* Mobil cihazlar için (daha da küçük) */
        @@media (max-width: 480px) {
            .login {
                width: 50%;
                padding: 12% 0 0;
            }

            .form {
                padding: 20px;
            }

            #btns {
                padding: 10px;
                font-size: 8px;
                word-wrap: break-word;
                white-space: normal;
                overflow-wrap: break-word;
                text-align: center;
            }

            .form input {
                padding: 10px;
                font-size: 8px;
            }

            #err {
                font-size: 8px !important;
            }
        }

        .footer-custom {
            position: fixed;
            left: 0;
            bottom: 0;
            width: 100vw;
            text-align: center;
            z-index: 9999;
            background: transparent; /* İstersen arka plan ekleyebilirsin */
            padding-bottom: 10px; /* Alt boşluk */
        }

        #alt1, #alt2 {
            margin: 0;
            padding: 0;
            color: cadetblue;
            font-size: 10px;
        }
    </style>
</head>

<body>

    <div class="container">

        @using (Html.BeginForm("Login", "Security", FormMethod.Post, new { autocomplete = "off" }))
        {
            @Html.ValidationSummary(true, "", new { @class = "text-danger" })
            <div class="login">
                <div class="form">
                    <div class="login-form " style="max-width:500px!important">
                        <div class="panel-heading">
                            <h3 class="panel-title" style="color:cadetblue"><b style="font-family: 'Comfortaa', cursive;">Crm Basis Portal</b></h3>

                        </div>
                        <div class="panel-body" style="margin-top:10px!important">

                            <div class="form-group" style="position:relative">

                                <small>E-Mail </small>

                                @Html.TextBoxFor(m => m.Email, new { @class = "form-control", @id = "email", @type = "email", @required = "required", @autocomplete = "off", @placeholder = "Ihre E-mail @" })
                            </div>
                            <div class="form-group" style="position:relative">
                                <small>Passwort</small>

                                @Html.PasswordFor(m => m.Passwort, new { @class = "form-control", @id = "password", @required = "required", @autocomplete = "current-password", @placeholder = "Ihre Passwort" })
                                <span class="toggle-password" toggle="#password" title="Passwort anzeigen/verbergen">
                                    <span class="glyphicon glyphicon-eye-open"></span>
                                </span>
                            </div>
                            <div>
                            </div>

                            <div class="check-box mt-4 mb-0" style="display: inline-flex; float:left;gap:5px">

                                <!--Alt-vers.-->
                                <input id="remember" name="remember" type="checkbox" value="Remember Me">

                                @*@Html.CheckBoxFor(m => m.RememberMe)*@
                                <b style="white-space:nowrap;font-size:10px;margin-top:0px;color:gray">Remember Me</b>

                            </div>

                           
                           


                            <button id="btns" class="btn btn-sm btn-success btn-block mt-0" type="submit">Login</button>

                        </div>

                    </div>
                    <ins id="err"> @ViewBag.Message <i class='bx bx-error-alt' style='color:#f14a1c'></i></ins>
                </div>

            </div>



        }

    </div>

</body>
</html>
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script>
    // jQuery yüklü ise aşağıdaki kodu kullanabilirsin
    $(function () {
        // Şifre Göster / Gizle Toggle
        $(document).on('click', '.toggle-password', function () {
            var input = $($(this).attr('toggle'));
            var icon = $(this).find('span');
            if (input.attr('type') === 'password') {
                input.attr('type', 'text');
                icon.removeClass('glyphicon-eye-open').addClass('glyphicon-eye-close');
            } else {
                input.attr('type', 'password');
                icon.removeClass('glyphicon-eye-close').addClass('glyphicon-eye-open');
            }
        });

        // Form submit işlemini dinle
        $('form').on('submit', function (event) {
            var button = $('#btns');
            // Eğer HTML5 validasyonunda hata varsa, animasyon gösterme, işlemi durdur
            if (!this.checkValidity()) {
                // Tarayıcı native validasyonunu göster
                this.reportValidity();
                event.preventDefault();
                return;
            }
            // Butonu devre dışı bırak, animasyon başlat
            button.prop('disabled', true);
            button.html('Authentifizierung läuft...');
            button.css('color', 'cadetblue');

            // Animasyonlu mesaj ekle
            var loadingDiv = $(`
            <div style="text-align:center; margin-top:15px;">
                <div class="spinner"></div>
                <p style=" color:#5f9ea0;" class="mt-1">Bitte warten...</p>
            </div>
        `);
            $('.panel-body').append(loadingDiv);

            // CSS animasyonu ekle (sadece bir kez eklenir)
            if (!$('style#spinner-style').length) {
                var style = `
                <style id="spinner-style">
                    .spinner {
                        margin-top:140px;
                        width: 30px;
                        height: 30px;
                        border: 4px solid #ffffff;
                        border-top: 4px solid #5f9ea0;
                        border-radius: 50%;
                        animation: spin 1s linear infinite;
                        margin: 0 auto;
                    }
                    @@keyframes spin {
                        0% { transform: rotate(0deg); }
                        100% { transform: rotate(360deg); }
                    }
                </style>
            `;
                $('head').append(style);
            }

            // Formun hemen gönderilmesini engelle, timeout ile gönder
            event.preventDefault();
            setTimeout(() => {
                this.submit();
            }, 3000);
        });
    });
</script>

<!--
 | Attribute       | Anlamı / Kullanımı                                      |
|-----------------|---------------------------------------------------------|
| @@type           | Input’un tipini belirtir (text, email, password, vs.)   |
| @@class          | CSS sınıfı ekler                                        |
| @@id             | Elementin eşsiz kimliği                                 |
| @@name           | Form gönderiminde alan adı olarak kullanılır            |
| @@placeholder    | Gri yazıyla ipucu/metin gösterir                        |
| @@value          | Varsayılan/gösterilecek değeri ayarlar                  |
| @@readonly       | Sadece okunur yapar, kullanıcı değiştiremez             |
| @@disabled       | Alanı pasifleştirir, gönderilmez                        |
| @@required       | Zorunlu alan yapar, boş bırakılamaz                     |
| @@maxlength      | Maksimum karakter sayısı                                |
| @@minlength      | Minimum karakter sayısı                                 |
| @@autocomplete   | Tarayıcı otomatik tamamlama davranışı                   |
| @@autofocus      | Sayfa açıldığında otomatik olarak o alanı odaklar       |
| @@pattern        | Düzenli ifadeyle (regex) doğrulama yapar                |
| @@min            | Sayısal/datepicker için minimum değer                   |
| @@max            | Sayısal/datepicker için maksimum değer                  |
| @@step           | Sayısal inputlarda artış miktarı                        |
| @@size           | Input kutusunun genişliğini belirler (karakter olarak)  |
| @@tabindex       | Tab tuşu ile geçiş sırasını belirler                    |
| @@title          | Üzerine gelince görülen açıklama/metin                  |
| @@style          | Satır içi CSS yazmanı sağlar                            |
| @@spellcheck     | Yazım denetimi aç/kapa (true/false)                     |
| @@multiple       | Birden fazla değer seçilebilir (file, email, vs.)       |
| @@onchange       | Değer değişince çalışacak JS kodu                       |
| @@onclick        | Tıklanınca çalışacak JS kodu                            |
| @@oninput        | Klavye ile veri girilince çalışır                       |
| @@data_something | Özel data attribute’ları (ör: data-toggle, data-id)     |
-->
