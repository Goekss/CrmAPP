@model CrmAPP.ViewModels.VerifyCodeViewModel

@{
    Layout = null;
}

<link href="//netdna.bootstrapcdn.com/bootstrap/3.0.0/css/bootstrap.min.css" rel="stylesheet" id="bootstrap-css" />
<script src="//netdna.bootstrapcdn.com/bootstrap/3.0.0/js/bootstrap.min.js"></script>
<script src="//code.jquery.com/jquery-1.11.1.min.js"></script>

<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>Onay Kodu</title>
    <link href="~/Content/bootstrap.min.css" rel="stylesheet" />

    <style>
        @@import url('https://fonts.googleapis.com/css2?family=Comfortaa&display=swap');

        body {
            background: #e0e0e0;
            padding-top: 100px;
            font-family: 'Comfortaa', cursive;
        }

        #err {
            color: red;
            font-size: 10px !important;
            text-align: center;
            font-family: 'Comfortaa', cursive;
        }

        .login {
            width: 300px;
            padding: 8% 0 0;
            margin: auto;
            font-family: 'Comfortaa', cursive;
            border-radius: 50px;
        }

        #btns {
            font-family: 'Comfortaa', cursive;
            text-transform: uppercase;
            outline: 0;
            background: #D4D4D4;
            margin-top: 25px;
            width: 100%;
            border: 0;
            border-radius: 5px;
            padding: 10px;
            margin-bottom:-15px !important;
            color: dimgray;
            font-size: 10px;
            -webkit-transition: all 0.3ms ease;
            transition: all 0.3s ease;
            cursor: pointer;
        }

            #btns:hover {
                background-color: cadetblue !important;
                color: white;
            }

        .form {
            position: relative;
            z-index: 1;
            background: #FFFFFF;
            border-radius: 10px;
            max-width: 600px;
            max-height: 400px !important;
            margin: 0 auto 80px;
            padding: 45px;
            text-align: center;
            border-radius: 50px;
            background: #e0e0e0;
            box-shadow: -11px 11px 22px #bebebe, 11px -11px 22px #ffffff;
        }

            .form input {
                outline: none !important;
                background: #e0e0e0;
                width: 100%;
                border: 0;
                border-radius: 5px;
                margin: 0 0 15px;
                padding: 15px;
                box-sizing: border-box;
                font-size: 10px;
                font-family: 'Comfortaa', cursive;
            }

                .form input:focus {
                    background: #e9e9e9;
                    box-shadow: inherit;
                }

        @@keyframes spin {
            0% {
                transform: rotate(0deg);
            }

            100% {
                transform: rotate(360deg);
            }
        }

        .form button:active, .form button::after {
            background-color: cadetblue !important;
        }

        @@media (max-width: 768px) {
            .login {
                width: 75%;
                padding: 10% 0 0;
            }

            .form {
                padding: 30px;
            }

            #btns {
                padding: 12px;
                font-size: 9px;
            }

            .form input {
                padding: 12px;
                font-size: 9px;
            }
        }

        @@media (max-width: 480px) {
            .login {
                width: 50%;
                padding: 12% 0 0;
            }

            .form {
                padding: 20px;
            }

            #btns {
                padding: 10px;
                font-size: 8px;
                word-wrap: break-word;
                white-space: normal;
                overflow-wrap: break-word;
                text-align: center;
            }

            .form input {
                padding: 10px;
                font-size: 8px;
            }

            #err {
                font-size: 8px !important;
            }
        }

        .footer-custom {
            position: fixed;
            left: 0;
            bottom: 0;
            width: 100vw;
            text-align: center;
            z-index: 9999;
            background: transparent;
            padding-bottom: 10px;
        }

        #alt1, #alt2 {
            margin: 0;
            padding: 0;
            color: cadetblue;
            font-size: 10px;
        }
    </style>
</head>

<body>
    <div class="container">
        @using (Html.BeginForm("VerifyCode", "Security", FormMethod.Post, new { autocomplete = "off" }))
        {
            @Html.ValidationSummary(true, "", new { @class = "text-danger" })
            <div class="login">
                <div class="form">
                    <div class="login-form " style="max-width:500px!important">
                        <div class="panel-heading">
                            <h3 class="panel-title" style="color:cadetblue">
                                <b style="font-family: 'Comfortaa', cursive;">Bestätigungscode</b>
                            </h3>
                        </div>
                        <div class="panel-body mb-0">
                            <div class="form-group mb-0" style="position:relative">
                                <i class='bx bx-mail-send'></i>
                                <div class="mb-4 mt-2">

                                    <small>Bitte geben Sie hier den <b>6-stelligen</b> Bestätigungscode ein, der an Ihre <u >E-Mail-Adresse</u> gesendet wurde:</small>
                                </div>


                                @Html.TextBoxFor(m => m.Code, new
                                {
                                    @class = "form-control",
                                    @id = "code",
                                    @type = "text",
                                    @required = "required",
                                    @autocomplete = "off",
                                    @placeholder = "Code eingeben",
                                    style = "background-color: #fff; color: #222; font-size: 1.5rem;"
                                })
                            </div>

                            <button id="btns" class="btn btn-sm btn-success btn-block mt-2 mb-0" type="submit"><h4>Verifizieren</h4></button>
                        </div>
                    </div>
                    <br />

                    <ins id="err"> @ViewBag.Message <i class='bx bx-error-alt' style='color:#f14a1c'></i></ins>
                    <br />

                </div>

                <p style="color:red">
                    <b>@Session["VerificationCode"]</b>

                </p>
            </div>
        }
    </div>

</body>
</html>
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script>
    $(function () {
        // Form submit işlemini dinle
        $('form').on('submit', function (event) {
            var button = $('#btns');
            // Eğer HTML5 validasyonunda hata varsa, animasyon gösterme, işlemi durdur
            if (!this.checkValidity()) {
                this.reportValidity();
                event.preventDefault();
                return;
            }
            // Butonu devre dışı bırak, animasyon başlat
            button.prop('disabled', true);
            button.html('wird überprüft...');
            button.css('color', 'cadetblue');

            // Animasyonlu mesaj ekle
            var loadingDiv = $(`
                <div style="text-align:center; margin-top:30px;">
                    <div class="spinner"></div>
                    <p style=" color:#5f9ea0;" class="mt-1">bitte Warten Sie ab...</p>
                </div>
            `);
            $('.panel-body').append(loadingDiv);

            // CSS animasyonu ekle (sadece bir kez eklenir)
            if (!$('style#spinner-style').length) {
                var style = `
                <style id="spinner-style">
                    .spinner {
                        margin-top:140px;
                        width: 30px;
                        height: 30px;
                        border: 4px solid #ffffff;
                        border-top: 4px solid #5f9ea0;
                        border-radius: 50%;
                        animation: spin 1s linear infinite;
                        margin: 0 auto;
                    }
                    @@keyframes spin {
                        0% { transform: rotate(0deg); }
                        100% { transform: rotate(360deg); }
                    }
                </style>
            `;
                $('head').append(style);
            }

            // Formun hemen gönderilmesini engelle, timeout ile gönder
            event.preventDefault();
            setTimeout(() => {
                this.submit();
            }, 2000);
        });
    });
</script>