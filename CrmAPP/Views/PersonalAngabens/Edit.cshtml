    }

    #img {
        width: 160px;
        height: 160px !important;
        box-shadow: 10px 12px 15px rgba(0, 0, 0, 0.3);
    }
</style>
<style>
    .image-preview {
        max-width: 150px;
        max-height: 150px;
        object-fit: cover;
        border-radius: 10px;
        margin-top: 10px;
    }

    .file-info {
        color: dimgray;
        font-size: 11px;
        margin-top: 10px;
    }
</style>




<br />
<br />

<!-- Anfang des  -->
@using (Html.BeginForm("Edit", "PersonalAngabens", FormMethod.Post, new { enctype = "multipart/form-data" }))
