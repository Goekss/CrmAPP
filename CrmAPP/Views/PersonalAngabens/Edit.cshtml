                        <input type="text" class="form-control" id="Hinweise" name="Hinweise" value="@Model.Hinweise">
                    </div>
                </div>-->
                <!-- Hinweise -->
                <div class="mb-3 col-md-6">
                    @Html.LabelFor(model => model.Hinweise, htmlAttributes: new { @class = "control-label col-md-6" })
                    <div class="input-group input-group-merge">
                        <span class="input-group-text" id="basic-icon-default-hinweise">
                            <i class="menu-icon tf-icons bx bx-notepad"></i>
                        </span>
                        @Html.TextAreaFor(model => model.Hinweise, 5, 70, new { @class = "form-control", id = "Hinweise", name = "Hinweise", aria_describedby = "basic-icon-default-hinweise" })
                    </div>
                    @Html.ValidationMessageFor(model => model.Hinweise, "", new { @class = "text-danger" })
                </div>

            </div>
            <br />
            <br />
            <i style="font-size:10px; color:royalblue">Änderungen speichern <b class="menu-icon tf-icon bx bx-error" style="color:darkorange; margin-bottom:9px"></b> </i>


            <!-- Submit Button -->
            <div class="form-actions">
                <button id="brbtn" type="submit" class="btn btn-warning" style=" border-radius:5px; padding:5px; padding-right:18px; color:black" title="Bearbeiten">
                    <i class="bx bx-edit" style="margin-left:9px; margin-right:7px; color:black"></i>
                    Bearbeiten
                </button>
            </div>

        </div>
    </div>

    <br />
    <br />

</div>
}

<hr />
<div>
    <div class="mt-2">
        <a href="/PersonalAngabens/Index" type="submit" class="btn btn-secondary" style=" font-size: 13px"><i class='bx bx-chevron-left' style=" margin-left:-10px"></i> Zurück zur Liste </a>
    </div>
</div>
<script>
    // Değişiklik yapılan alanları saklamak için bir obje oluşturuyoruz
    let changes = {};

    // Her input'a onchange event ekliyoruz
    document.querySelectorAll('input').forEach(input => {
        input.addEventListener('input', function () {
            // Eğer bir değişiklik varsa, bu değeri 'changes' objesine ekliyoruz
            if (this.value !== this.defaultValue) {
                changes[this.name] = `${this.name} geändert`;  // İsim değiştirildi gibi
            } else {
                // Eğer değer eski haline dönerse, değişiklikleri siliyoruz
                delete changes[this.name];
            }
        });
    });

   
</script>
<script>
    // Şifreyi gösterme/gizleme fonksiyonu
    function togglePasswordVisibility() {
        var passwordField = document.getElementById('Passwort');
        var icon = document.getElementById('toggle-password-icon');

        // Şifreyi gösterme/gizleme
        if (passwordField.type === "password") {
            passwordField.type = "text";  // Şifreyi görünür hale getir
            icon.classList.remove('bx-key');  // Anahtar ikonunu değiştir
            icon.classList.add('bx-show');  // Şifreyi gösteren ikon
        } else {
            passwordField.type = "password";  // Şifreyi gizle
            icon.classList.remove('bx-show');  // Göster ikonunu değiştir
            icon.classList.add('bx-key');  // Anahtar ikonunu tekrar göster
        }
    }
</script>

<script>
    // Dosya yükleme işlemi ve resim önizlemesi
    document.getElementById('Bild').addEventListener('change', function (event) {
        const file = event.target.files[0];
        const imagePreview = document.getElementById('imagePreview');

        // Önceki önizlemeyi temizle (güvenli bir şekilde)
        while (imagePreview.firstChild) {
            imagePreview.removeChild(imagePreview.firstChild);
        }

        if (file) {
            // Dosya boyutunu al (bayt cinsinden)
            const fileSizeInBytes = file.size;
            const fileSizeInKB = (fileSizeInBytes / 1024).toFixed(2);
            const maxFileSizeInKB = 2048; // 2 MB

            // Geçerli dosya türü kontrolü (sadece JPEG ve PNG)
            if (file.type === "image/jpeg" || file.type === "image/png") {
                // Dosya boyutu kontrolü
                if (fileSizeInKB <= maxFileSizeInKB) {
                    // Resim önizlemesini ekle
                    const imageUrl = URL.createObjectURL(file);
                    imagePreview.innerHTML = `
                        <img src="${imageUrl}" alt="Image Preview" class="image-preview"/>
                        <p class="file-info"><i class='bx bx-image'></i> ${fileSizeInKB} KB</p>
                    `;
                } else {
                    alert("Dosya boyutu 2 MB'ı aşmamalıdır!");
                    // Geçersiz dosya seçildiğinde dosya input'unu temizle
                    event.target.value = '';
                }
            } else {
                alert("Bitte laden Sie die Datei nur als JPEG oder PNG hoch! ");
                // Geçersiz dosya seçildiğinde dosya input'unu temizle
                event.target.value = '';
            }
        }
    });
</script>