                    </div>
                </div>

                <br />

                <!-- Email -->
                <div class="mb-3 col-md-6">
                    @Html.LabelFor(model => model.Email, htmlAttributes: new { @class = "control-label col-md-6" })
                    <div class="input-group input-group-merge">
                        <span id="basic-icon-default-fullname2" class="input-group-text"> <i class="menu-icon tf-icons bx bx-envelope"></i></span>
                        <input type="email" class="form-control" id="Email" name="Email" value="@Model.Email">
                    </div>
                    @Html.ValidationMessageFor(model => model.Email, "", new { @class = "text-danger" })
                </div>

                <br />

                <!-- Passwort -->
                @*<div class="mb-3 col-md-6">
                        @Html.LabelFor(model => model.Passwort, htmlAttributes: new { @class = "control-label col-md-6" })
                        <div class="input-group input-group-merge">
                            <span id="basic-icon-default-fullname2" class="input-group-text"><i class="menu-icon tf-icons bx bxs-key"></i></span>
                            <input type="password" class="form-control" id="Passwort" name="Passwort" maxlength="9" value="@Model.Passwort" >
                        </div>
                    </div>*@

                <!-- Passwort Vers.2-->
                <div class="mb-3 col-md-6">
                    @Html.LabelFor(model => model.Passwort, htmlAttributes: new { @class = "control-label col-md-6" })
                    <div class="input-group input-group-merge">
                        <span id="basic-icon-default-fullname2" class="input-group-text">
                            <i id="toggle-password-icon" class="menu-icon tf-icons bx bxs-key" onclick="togglePasswordVisibility()"></i> <!-- Anahtar ikonu -->
                        </span>
                        <input type="password" class="form-control" id="Passwort" name="Passwort" maxlength="9" value="@Model.Passwort" readonly>
                    </div>
                </div>
                <br />

                <!-- Rufnummer -->
                <div class="mb-3 col-md-6">
                    @Html.LabelFor(model => model.RufNummer, htmlAttributes: new { @class = "control-label col-md-6" })
                    <div class="input-group input-group-merge">
                        <span id="basic-icon-default-fullname2" class="input-group-text"><i class="menu-icon tf-icons bx bx-phone-call"></i></span>
                        <input type="tel" class="form-control" id="RufNummer" name="RufNummer" value="@Model.RufNummer" maxlength="15"
                               pattern="^\+?[0-9]*$" required oninput="validateInput(this)">


                    </div>
                </div>

                <br />

                <!-- Abteilung -->
                @*<div class="mb-3 col-md-6">

                        @Html.LabelFor(model => model.Abteilung, htmlAttributes: new { @class = "control-label col-md-6" })
                        <div class="input-group input-group-merge">
                            <span id="basic-icon-default-fullname2" class="input-group-text"><i class="menu-icon tf-icons bx bx-building-house"></i></span>
                            <input class="form-control" type="text" name="Abteilung" id="Abteilung" value="@Model.Abteilung" />

