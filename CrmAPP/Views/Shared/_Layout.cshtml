    <style>
        .bg-menu-theme .menu-link:hover {
            background-color: #eeeeee !important;
            color: black !important;
        }

        .menu-item .menu-link {
            text-decoration: none !important; /* Varsayılan */
        }

            .menu-item .menu-link:hover,
            .menu-item .menu-link:focus,
            .menu-item.active .menu-link {
                text-decoration: underline; /* Alt çizgiyi göster */
            }

        .bg-menu-theme .menu-inner > .menu-item.active > .menu-link {
            color: white;
            background-color: #8fbbbd !important;
        }

        .bg-menu-theme .menu-inner > .menu-item.active:before {
            background: cadetblue !important;
            height: 47px !important;
        }
        /* GENERELL SCROLLBAR */
        .layout-menu::-webkit-scrollbar {
            width: 2px;
        }

        .layout-menu::-webkit-scrollbar-thumb {
            background-color: #888;
            opacity: 0.8;
            border-radius: 4px;
        }

        .layout-menu::-webkit-scrollbar-track {
            background-color: #f1f1f1;
        }

        .menu-link {
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap; /* İçeriği tek satırda kısıtlar */
        }

        .menu-inner {
            word-wrap: break-word; /* Taşan kelimeleri böler */
        }


        /* === SEARCH === */
        /*.navbar-nav {
            position: relative;*/ /* Arama alanını çevreleyen kapsayıcı */
        /*}*/

        #autocomplete-list {
            position: absolute; /* Kapsayıcıya göre konumlandır */
            background-color: white;
            border: none;
            border-radius: 15px;
            width: 33%; /* Input genişliğiyle aynı */
            list-style-type: none;
            margin: 0;
            padding: 0;
            transition: background-color 0.3s ease;
            box-shadow: 0px 4px 6px rgba(0, 0, 0, 0.1); /* Hafif gölge */
            z-index: 999; /* Üst katmanda görünsün */
            top: 100%; /* Input alanının tam altına hizala */
            left: 0; /* Input alanının soluna hizala */
        }

            #autocomplete-list li {
                padding: 8px 16px;
                cursor: pointer;
                font-size: 12px;
                color: dimgray;
                font-family: 'Segoe UI', 'Roboto', 'Helvetica Neue', Arial, sans-serif;
            }

                #autocomplete-list li:hover {
                    background: #ffffff;
                    background: linear-gradient(261deg,rgba(255, 255, 255, 1) 0%, rgba(130, 130, 130, 1) 100%, rgba(0, 0, 0, 1) 100%);
                    color: white;
                }




        /* === RESPONSIVE === */

        @@media (max-width: 769px) {
            .dropdown-menu {
                position: absolute !important;
                right: 0 !important; /* Sağ köşeye yapıştır */
                left: auto !important; /* Solu sıfırla */
                max-width: 90vw; /* Ekranın %90'ı kadar genişlik */
                min-width: unset !important; /* Bootstrap varsayılanını iptal et */
                white-space: normal !important; /* Yazı taşmasın */
                word-wrap: break-word;
                overflow-wrap: break-word;
                word-break: break-word;
                box-sizing: border-box;
                z-index: 9999;
            }
        }

        /* Dropdown'un dışına taşmaması ve sola doğru genişlemesi için */
        .my-dropdown-menu {
            position: absolute !important;
            right: 0 !important; /* SAĞA sabitle */
            left: -100px !important; /* SOLU sıfırla */
            max-width: 90vw; /* Ekran genişliğinin %90’ı kadar */
            min-width: unset !important; /* Bootstrap’in sabit min-width’ini iptal et */
            white-space: normal !important; /* Yazılar alt satıra geçebilsin */
            word-wrap: break-word;
            overflow-wrap: break-word;
            word-break: break-word;
            box-sizing: border-box;
            z-index: 9999;
            padding: 0.75rem 1rem;
        }

        /* Dropdown kapsayıcısının pozisyonu göreli olmalı */
        .dropdown {
            position: relative;
        }
        /* 1) 576px ve Altı (En geniş mobil) */
        @@media (max-width: 576px) {
            .layout-menu {
                width: 48vw !important;
                min-width: 140px !important;
                max-width: 90vw !important;
                padding-left: 6px !important;
                padding-right: 6px !important;
                overflow-x: auto; /* Taşmayı önler */
            }

            .menu-link,
            .menu-inner .menu-link {
                font-size: 14px !important;
                padding: 10px 8px !important;
            }

            .menu-item .menu-link > i,
            .menu-item .menu-link > .menu-icon {
                font-size: 14px !important;
                margin-right: 8px !important;
            }

            .menu-inner {
                padding-left: 0 !important;
                padding-right: 0 !important;
            }
        }

        /* 2) 530px ve Altı */
        @@media (max-width: 530px) {
            .layout-menu {
                z-index: 1202 !important;
                position: fixed !important;
                left: 0;
                top: 0;
                bottom: 0;
                width: auto !important;
                min-width: 120px !important;
                max-width: 80vw !important;
                background: #fff !important;
                overflow-y: auto; /* Dikey taşmayı engeller */
            }

            .layout-navbar {
                z-index: 1000 !important;
                position: fixed !important;
                top: 0;
                left: 0;
                right: 0;
            }

            .layout-overlay {
                z-index: 1201 !important;
            }

            .menu-link,
            .menu-inner .menu-link {
                font-size: 13px !important;
                padding: 8px 6px !important;
            }

            .menu-item .menu-link > i,
            .menu-item .menu-link > .menu-icon {
                font-size: 13px !important;
                margin-right: 7px !important;
            }
        }

        /* 3) 500px ve Altı (En küçük mobil) */
        @@media (max-width: 500px) {
            .layout-menu {
                width: auto !important;
                min-width: 100px !important;
                max-width: 100vw !important;
                padding-left: 4px !important;
                padding-right: 4px !important;
                background: #fff !important;
                z-index: 1202 !important;
                overflow-x: hidden; /* Yatay taşmayı engeller */
            }

            .menu-link,
            .menu-inner .menu-link {
                font-size: 13px !important;
                padding: 7px 3px !important;
                white-space: normal !important;
                word-break: break-word !important;
            }

            .menu-item .menu-link > i,
            .menu-item .menu-link > .menu-icon {
                font-size: 13px !important;
                margin-right: 7px !important;
            }

            .menu-inner {
                padding-left: 0 !important;
                padding-right: 0 !important;
            }
        }
    </style>




