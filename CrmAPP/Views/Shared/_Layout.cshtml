    <script>
        function logout() {
            // Tarayıcıda bulunan oturumu (session veya cookie) temizle
            // Bu kısmı uygulamanızın backend yapısına göre uyarla.

            // Örneğin, eğer session kullanıyorsanız:
            // localStorage.clear(); // Veya sessionStorage.clear();
            // Veya cookie'yi temizleyebilirsiniz:
            // document.cookie = "username=; expires=Thu, 01 Jan 1970 00:00:00 UTC; path=/;";

            // Sonrasında kullanıcıyı login sayfasına yönlendir.
            window.location.href = "https://localhost:44312/THEMA/html/auth-login-basic.html";  // Çıkış yapıldığında yönlendirmek istediğiniz sayfa
        }


    </script>

    <script>
        function toggleMenu(event, element) {
            event.preventDefault();
            const parentItem = element.closest(".menu-item");
            const submenu = parentItem.querySelector(".menu-sub");
            const arrowIcon = parentItem.querySelector(".arrow-icon");

            // Aç/Kapa işlemi
            if (submenu.style.display === "none" || submenu.style.display === "") {
                submenu.style.display = "block";
                arrowIcon.classList.remove("bx-chevron-right");
                arrowIcon.classList.add("bx-chevron-down");
            } else {
                submenu.style.display = "none";
                arrowIcon.classList.remove("bx-chevron-down");
                arrowIcon.classList.add("bx-chevron-right");
            }
        }
    </script>

    <script>
    // Kullanıcı rolü sunucu tarafından kontrol edilip JavaScript'e aktarılıyor
    const userRole = '@Session[$"benutzerRol_{User.Identity.Name}"]';
    </script>

    <script>

        const sidebarLinks = {
            'Dashboard': { url: '/Dashboard/Index/', icon: 'bx bxs-dashboard' },
            'Team & List': { url: '/PersonalAngabens/Index/', icon: 'bx bxs-user-rectangle' },
            'Person anlegen': { url: '/PersonalAngabens/Create/', icon: 'bx bx-user-plus' },
            'Kontakt & Cards': { url: '/PersonalAngabens/PersonalCard/', icon: 'bx bx-id-card' },
            'Kunden & Liste': { url: '/KundenDatens/Index/', icon: 'bx bxs-group' },
            'Neue Kunden': { url: '/KundenDatens/Create/', icon: 'bx bxs-user-plus' },
            'Projekte & List': { url: '/PersonalProjektes/Index/', icon: 'bx bxs-briefcase-alt-2' },
            'Neue Projekte': { url: '/PersonalProjektes/Create/', icon: 'bx bx-bookmark-alt-plus' },
            'Support': { url: '/LiveSupport/LiveSupport/', icon: 'bx bx-support' },
            'Site Map': { url: '/LiveSupport/TreeView/', icon: 'bx bx-map' },
            // VISTA bağlantısını sadece Admin ve Moderator rollerine görünür yap
            ...(userRole === 'Admin' || userRole === 'Moderator' ? {
                'Vista': {
                    url: 'http://localhost:3000',
                    icon: 'bx bx-link-external',
                }
            } : {})
        };




        const input = document.getElementById('search-input');
        const autocompleteList = document.getElementById('autocomplete-list');

        // Kullanıcı yazmaya başladığında önerileri göster
        input.addEventListener('input', function () {
            const query = input.value.trim().toLowerCase();
            autocompleteList.innerHTML = ''; // Listeyi temizle
            autocompleteList.style.display = 'none';

            if (query) {
                const matchingItems = Object.keys(sidebarLinks).filter(item => item.toLowerCase().includes(query));
                if (matchingItems.length > 0) {
                    autocompleteList.style.display = 'block'; // Listeyi göster
                    matchingItems.forEach(item => {
                        const listItem = document.createElement('li');
                        listItem.classList.add('list-group-item');
                        listItem.style.display = 'flex';
                        listItem.style.alignItems = 'center';
                        listItem.style.gap = '10px';

                        // İkon ekle
                        const iconElement = document.createElement('i');
                        iconElement.className = `tf-icon tf-icons ${sidebarLinks[item].icon}`;
                        iconElement.style.color = 'dimgray'; // İkon rengi
                        listItem.appendChild(iconElement);

                        // Yazıyı ekle
                        const textElement = document.createElement('span');
                        textElement.textContent = item;
                        listItem.appendChild(textElement);

                        // Tıklama olayını ekle
                        listItem.addEventListener('click', function () {
                            input.value = item; // Tıklanan öneriyi input alanına yaz
                            autocompleteList.style.display = 'none'; // Listeyi gizle

                            // Eğer Vista ise yeni sekmede aç
                            if (item === 'Vista') {
                                window.open(sidebarLinks[item].url, '_blank');
                            } else {
                                // Diğerleri için mevcut sekmede yönlendir
                                window.location.href = sidebarLinks[item].url;
                            }
                        });

                        autocompleteList.appendChild(listItem);
                    });
                }
            }
        });

        // Enter tuşuyla arama yap
        input.addEventListener('keydown', function (event) {
            if (event.key === 'Enter') {
                const query = input.value.trim();
                if (sidebarLinks[query]) {
                    // Enter tuşuyla Vista kontrolü
                    if (query === 'Vista') {
                        window.open(sidebarLinks[query].url, '_blank');
                    } else {
                        window.location.href = sidebarLinks[query].url;
                    }
                } else {
                    alert('Kein Ergebnis gefunden! Bitte geben Sie einen gültigen Suchbegriff ein.');
                }
                autocompleteList.style.display = 'none'; // Listeyi gizle
            }
        });

        // Öneriler dışındaki bir yere tıklanınca listeyi gizle
        document.addEventListener('click', function (event) {
            if (!autocompleteList.contains(event.target) && event.target !== input) {
                autocompleteList.style.display = 'none';
            }
        });


    </script>

    @RenderSection("scripts", required: false)
</body>


</html>

